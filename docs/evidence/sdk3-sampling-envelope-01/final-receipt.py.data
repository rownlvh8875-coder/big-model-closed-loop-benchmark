from pathlib import Path
from datetime import datetime,timezone,timedelta
from concurrent.futures import ThreadPoolExecutor
import hashlib,json,shutil,subprocess,sys
R=Path('/dev/shm/stage7-sdk3-runtime-20261116/repo');T=Path('/dev/shm/stage7-sdk3-sampling-envelope-20261117');BASE='d6eb529d52364117a01d446652f2e938089625c2';P='repos/rownlvh8875-coder/big-model-closed-loop-benchmark/';number=json.loads((T/'pr-number.json').read_text())['number'];e=R/'docs/evidence/sdk3-sampling-envelope-01';outroot=R/'output/stage7-sdk3-sampling-envelope-01'
