delta=git('diff','--name-status',BASE,head).splitlines();assert delta and all(row.startswith('A\t') for row in delta);subprocess.run(['git','diff','--check',BASE,head],cwd=R,check=True)
a=json.loads((e/'input-analysis.json').read_text());x=json.loads((e/'result.json').read_text());assert not git('diff','--name-only',a['cpu_code_commit'],head,'--','scripts','tests')
for row in json.loads((e/'input-index.json').read_text())['files']:
 p=R/row['path'];assert p.stat().st_size==row['nbytes'] and digest(p)==row['sha256']
for row in json.loads((e/'result-index.json').read_text())['files']:
 p=R/row['path'];assert p.stat().st_size==row['nbytes'] and digest(p)==row['sha256']
for row in json.loads((e/'review/before-fix/index.json').read_text())['files']:
 p=R/row['path'];assert p.stat().st_size==row['nbytes'] and digest(p)==row['sha256']
assert digest(e/'result.json')==a['result_sha256']=='e50301ff29c205abf85b61187c1682fb98d23b3fb163e6cf1e135ef99cf4a05c' and a['models_checked']==x['scenario_count']==x['modeled_scenario_count']==x['modeled_yellow_count']==135 and len(x['points'])==5 and a['all_models_yellow'] and a['conditional_intervals_checked']==10 and x['native_renderer_processes_this_step']==x['official_model_processes']==x['onnx_inferences']==0 and x['fresh_source_images_verified'] is False
