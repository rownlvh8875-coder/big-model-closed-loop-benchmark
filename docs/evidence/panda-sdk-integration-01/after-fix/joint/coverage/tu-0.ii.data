inline CullableObject::
CullableObject(ConstPointerTo< Geom > geom, ConstPointerTo< RenderState > state,
               ConstPointerTo< TransformState > internal_transform) :
  _geom(std::move(geom)),
  _state(std::move(state)),
  _internal_transform(std::move(internal_transform))
{

  MemoryUsage::record_pointer(this, get_class_type());

