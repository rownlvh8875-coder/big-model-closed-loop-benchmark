inline LVector3i LVector3i::
back(CoordinateSystem cs) {
  return -forward(cs);
}





inline LVector3i LVector3i::
rfu(int right_v, int fwd_v, int up_v,
    CoordinateSystem cs) {




  if (cs == CS_default) {
    cs = get_default_coordinate_system();
  }

  int vy, vz;
  switch(cs) {
  case CS_yup_right:
    vz = -fwd_v;
    vy = up_v;
    break;

  case CS_yup_left:
    vz = fwd_v;
    vy = up_v;
    break;

  case CS_zup_right:
    vy = fwd_v;
    vz = up_v;
    break;

  case CS_zup_left:
    vy = -fwd_v;
    vz = up_v;
    break;

  default:
    linmath_cat.error()
      << "Invalid coordinate system!\n";
    return LVector3i(0);
  }

  return LVector3i(right_v, vy, vz);
}
