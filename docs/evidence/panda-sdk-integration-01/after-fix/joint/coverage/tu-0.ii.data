inline int WeakNodePath::
compare_to(const WeakNodePath &other) const {
  return other._head.owner_before(_head) - _head.owner_before(other._head);
}




inline int WeakNodePath::
get_key() const {
  if (auto head = _head.lock()) {
    _backup_key = head->get_key();
  }
  return _backup_key;
}

