xform(const LVecBase4f &v) const {
  ;
  LVecBase4f v_res;




  v_res._v(0) = v._v(0)*(*this)._m(0, 0) + v._v(1)*(*this)._m(1, 0) + v._v(2)*(*this)._m(2, 0) + v._v(3)*(*this)._m(3, 0); v_res._v(1) = v._v(0)*(*this)._m(0, 1) + v._v(1)*(*this)._m(1, 1) + v._v(2)*(*this)._m(2, 1) + v._v(3)*(*this)._m(3, 1); v_res._v(2) = v._v(0)*(*this)._m(0, 2) + v._v(1)*(*this)._m(1, 2) + v._v(2)*(*this)._m(2, 2) + v._v(3)*(*this)._m(3, 2); v_res._v(3) = v._v(0)*(*this)._m(0, 3) + v._v(1)*(*this)._m(1, 3) + v._v(2)*(*this)._m(2, 3) + v._v(3)*(*this)._m(3, 3);;

