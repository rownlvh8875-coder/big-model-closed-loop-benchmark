inline void Filename::
set_type(Filename::Type type) {
  _flags = (_flags & ~F_type) | type;
  switch (type) {
  case T_dso:
  case T_executable:
    set_binary();

  case T_general:
    break;
  }
}





inline Filename::Type Filename::
get_type() const {
  return (Type)(_flags & (int)F_type);
}
