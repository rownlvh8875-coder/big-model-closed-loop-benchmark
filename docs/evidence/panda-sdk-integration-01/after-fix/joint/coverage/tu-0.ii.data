  for (int i = 0; i < _fb_properties.get_aux_float(); ++i) {
    psd::call<PSD_READ_BUFFER>(glReadBuffer, next);
    glDrawBuffer(next);
    glgsg->_glBlitFramebuffer(0, 0, _rb_size_x, _rb_size_y, 0, 0, _rb_size_x, _rb_size_y,
                              0x00004000, 0x2600);
    next += 1;
  }

  report_my_errors(2063, "panda/src/glstuff/glGraphicsBuffer_src.cxx");


  glgsg->_glBindFramebuffer(0x8CA8, fbo);


  if (_have_any_color) {
    glDrawBuffer(0x8CE0);
    psd::call<PSD_READ_BUFFER>(glReadBuffer, 0x8CE0);
  } else {
    glDrawBuffer(0);
    psd::call<PSD_READ_BUFFER>(glReadBuffer, 0);
  }

  report_my_errors(2077, "panda/src/glstuff/glGraphicsBuffer_src.cxx");
}
