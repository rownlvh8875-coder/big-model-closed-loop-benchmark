static inline float
get_standardized_rotation(float angle_in_degrees) {
  if (angle_in_degrees<0.0) {
    angle_in_degrees = 360.0f - fmod(angle_in_degrees * -1.0f, 360.0f);
  } else {
    angle_in_degrees = fmod(angle_in_degrees, 360.0f);
  }



  return (angle_in_degrees<180.0f)?
      angle_in_degrees:
      angle_in_degrees - 360.0f;
}
