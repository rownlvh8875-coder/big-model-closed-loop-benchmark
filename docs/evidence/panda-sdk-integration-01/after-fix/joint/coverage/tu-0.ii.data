      if (!get_sampler_texture_type(bind._desired_type, param_type)) {
        glgsg_cat.error()
          << "Could not bind texture input " << param_name << "\n";
        return;
      }

      if (size > 7 && isdigit(noprefix[7])) {

        bind._part = Shader::STO_stage_i;

