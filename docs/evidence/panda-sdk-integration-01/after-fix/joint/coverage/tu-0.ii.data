inline ParamTextureImage::
ParamTextureImage(Texture *tex, bool read, bool write, int z, int n) :
  _texture(tex),
  _access(0),
  _bind_level((std::min)(n, 127)),
  _bind_layer(z)
{
  if (read) {
    _access |= A_read;
  }
  if (write) {
    _access |= A_write;
  }
  if (z < 0) {
    _bind_layer = 0;
    _access |= A_layered;
  }
}





inline TypeHandle ParamTextureImage::
get_value_type() const {
  return Texture::get_class_type();
}




