class AtomicAdjustGccImpl {
public:


  typedef __attribute__ ((aligned (8))) long Integer;



  typedef void *UnalignedPointer;
  typedef __attribute__ ((aligned (8))) UnalignedPointer Pointer;

  inline static void inc(volatile Integer &var);
  inline static bool dec(volatile Integer &var);
  inline static Integer add(volatile Integer &var, Integer delta);
  inline static Integer set(volatile Integer &var, Integer new_value);
  inline static Integer get(const volatile Integer &var);

  inline static Pointer set_ptr(volatile Pointer &var, Pointer new_value);
  inline static Pointer get_ptr(const volatile Pointer &var);

  inline static Integer compare_and_exchange(volatile Integer &mem,
                                             Integer old_value,
                                             Integer new_value);

  inline static Pointer compare_and_exchange_ptr(volatile Pointer &mem,
                                                 Pointer old_value,
                                                 Pointer new_value);
};

