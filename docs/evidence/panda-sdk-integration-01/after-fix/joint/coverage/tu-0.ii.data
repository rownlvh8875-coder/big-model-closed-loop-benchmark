void GLGraphicsStateGuardian::
update_show_usage_texture_bindings(int show_stage_index) {
  int num_stages = _target_texture->get_num_on_ff_stages();

  { if ((__builtin_expect(!(num_stages <= _max_texture_stages && _num_active_texture_stages <= _max_texture_stages), 0))) { if (Notify::ptr()->assert_failure("num_stages <= _max_texture_stages && _num_active_texture_stages <= _max_texture_stages", 12128, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } }
                                                             ;

  _texture_involves_color_scale = false;




  int i;
  for (i = 0; i < num_stages; i++) {
    TextureStage *stage = _target_texture->get_on_ff_stage(i);
    Texture *texture = _target_texture->get_on_texture(stage);
    { if ((__builtin_expect(!(texture != nullptr), 0))) { if (Notify::ptr()->assert_failure("texture != nullptr", 12140, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };

    int view = get_current_tex_view_offset() + stage->get_tex_view_offset();
    TextureContext *tc = texture->prepare_now(view, _prepared_objects, this);
    if (tc == nullptr) {

      break;
    }
    tc->enqueue_lru(&_prepared_objects->_graphics_memory_lru);
  }


  if (has_fixed_function_pipeline()) {

    for (i = 0; i < _num_active_texture_stages; i++) {
      set_active_texture_stage(i);

      glDisable(0x0DE0);

      glDisable(0x0DE1);
      if (_supports_3d_texture) {

        glDisable(0x806F);

      }
      if (_supports_cube_map) {
        glDisable(0x8513);
      }
    }
  }



  _num_active_texture_stages = num_stages;

  if (num_stages > 0) {

    if (show_stage_index >= 0 && show_stage_index < num_stages) {
      i = show_stage_index;
    } else {
      i = _show_texture_usage_index % num_stages;
    }

    TextureStage *stage = _target_texture->get_on_ff_stage(i);
    Texture *texture = _target_texture->get_on_texture(stage);
    { if ((__builtin_expect(!(texture != nullptr), 0))) { if (Notify::ptr()->assert_failure("texture != nullptr", 12185, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };


    set_active_texture_stage(i);

    if (has_fixed_function_pipeline()) {
      glEnable(0x0DE1);
    }


    UsageTextureKey key(texture->get_x_size(), texture->get_y_size());
    UsageTextures::iterator ui = _usage_textures.find(key);
    GLuint index;
    if (ui == _usage_textures.end()) {

      glGenTextures(1, &index);
      glBindTexture(0x0DE1, index);


      upload_usage_texture(texture->get_x_size(), texture->get_y_size());
      _usage_textures[key] = index;

    } else {

      index = (*ui).second;
      glBindTexture(0x0DE1, index);
    }

    if (glgsg_cat.is_spam()) {
      glgsg_cat.spam()
        << "glBindTexture(GL_TEXTURE_2D, " << index << ")\n";
    }


  }

  report_my_errors(12221, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
}







void GLGraphicsStateGuardian::
upload_usage_texture(int width, int height) {
  glTexParameteri(0x0DE1, 0x2802, 0x2901);
  glTexParameteri(0x0DE1, 0x2803, 0x2901);
  glTexParameteri(0x0DE1, 0x2801, 0x2700);
  glTexParameteri(0x0DE1, 0x2800, 0x2600);

  if (glgsg_cat.is_debug()) {
    glgsg_cat.debug()
      << "upload_usage_texture(" << width << ", " << height << ")\n";
  }

  static LColor colors[3] = {
    LColor(0.4, 0.5f, 0.8f, 1.0f),
    LColor(1.0f, 1.0f, 0.0f, 1.0f),
    LColor(0.8f, 0.3, 0.3, 1.0f),
  };



  uint32_t *buffer = (uint32_t *)((__builtin_assume_aligned(memory_hook->heap_alloc_array(width * height * 4), 16)));

  int n = 0;
  while (true) {

    LColor c = colors[min(n, 2)];



    union {
      struct {
        unsigned char r, g, b, a;
      } b;
      uint32_t w;
    } store;

    store.b.r = (unsigned char)(c[0] * 255.0f);
    store.b.g = (unsigned char)(c[1] * 255.0f);
    store.b.b = (unsigned char)(c[2] * 255.0f);
    store.b.a = 0xff;


    int num_pixels = width * height;
    for (int p = 0; p < num_pixels; ++p) {
      buffer[p] = store.w;
    }

    glTexImage2D(0x0DE1, n, 0x1908, width, height, 0,
                 0x1908, 0x1401, buffer);
    if (width == 1 && height == 1) {

      break;
    }

    width = max(width >> 1, 1);
    height = max(height >> 1, 1);
    ++n;
  }

  memory_hook->heap_free_array(buffer);
}






void GLGraphicsStateGuardian::
disable_standard_texture_bindings() {

  for (int i = 0; i < _num_active_texture_stages; i++) {
    set_active_texture_stage(i);

    glDisable(0x0DE0);

    glDisable(0x0DE1);
    if (_supports_3d_texture) {

      glDisable(0x806F);

    }
    if (_supports_cube_map) {
      glDisable(0x8513);
    }
  }

  _num_active_texture_stages = 0;

  report_my_errors(12318, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
}






void GLGraphicsStateGuardian::
do_issue_tex_matrix() {
  { if ((__builtin_expect(!(_num_active_texture_stages <= _max_texture_stages), 0))) { if (Notify::ptr()->assert_failure("_num_active_texture_stages <= _max_texture_stages", 12328, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };

  for (int i = 0; i < _num_active_texture_stages; i++) {
    TextureStage *stage = _target_texture->get_on_ff_stage(i);
    set_active_texture_stage(i);

    glMatrixMode(0x1702);

    const TexMatrixAttrib *target_tex_matrix;
    _target_rs->get_attrib_def(target_tex_matrix);

    if (target_tex_matrix->has_stage(stage)) {
      call_glLoadMatrix(target_tex_matrix->get_mat(stage));
    } else {
      glLoadIdentity();







    }
  }
  report_my_errors(12352, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
}






void GLGraphicsStateGuardian::
do_issue_tex_gen() {
  { if ((__builtin_expect(!(_num_active_texture_stages <= _max_texture_stages), 0))) { if (Notify::ptr()->assert_failure("_num_active_texture_stages <= _max_texture_stages", 12362, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };






  static const PN_stdfloat s_data[4] = { 1, 0, 0, 0 };
  static const PN_stdfloat t_data[4] = { 0, 1, 0, 0 };
  static const PN_stdfloat r_data[4] = { 0, 0, 1, 0 };
  static const PN_stdfloat q_data[4] = { 0, 0, 0, 1 };


  _tex_gen_modifies_mat = false;

  for (int i = 0; i < _num_active_texture_stages; i++) {
    set_active_texture_stage(i);
    if (_supports_point_sprite) {



      glTexEnvi(0x8861, 0x8862, 0);

    }


    glDisable(0x0C60);
    glDisable(0x0C61);
    glDisable(0x0C62);
    glDisable(0x0C63);

    TextureStage *stage = _target_texture->get_on_ff_stage(i);
    TexGenAttrib::Mode mode = _target_tex_gen->get_mode(stage);
    switch (mode) {
    case TexGenAttrib::M_off:
    case TexGenAttrib::M_unused2:
      break;

    case TexGenAttrib::M_eye_sphere_map:
      glTexGeni(0x2000, 0x2500, 0x2402);
      glTexGeni(0x2001, 0x2500, 0x2402);
      glEnable(0x0C60);
      glEnable(0x0C61);
      break;

    case TexGenAttrib::M_eye_cube_map:
      if (_supports_cube_map) {



        LMatrix4 mat = _inv_cs_transform->get_mat();
        mat.set_row(3, LVecBase3(0.0f, 0.0f, 0.0f));
        glMatrixMode(0x1702);
        glMultMatrixf(mat.get_data());



        _tex_gen_modifies_mat = true;

        glTexGeni(0x2000, 0x2500, 0x8512);
        glTexGeni(0x2001, 0x2500, 0x8512);
        glTexGeni(0x2002, 0x2500, 0x8512);
        glEnable(0x0C60);
        glEnable(0x0C61);
        glEnable(0x0C62);
      }
      break;

    case TexGenAttrib::M_world_cube_map:
      if (_supports_cube_map) {





        ConstPointerTo< TransformState > camera_transform = _scene_setup->get_camera_transform()->compose(_inv_cs_transform);

        LMatrix4 mat = camera_transform->get_mat();
        mat.set_row(3, LVecBase3(0.0f, 0.0f, 0.0f));
        glMatrixMode(0x1702);
        glMultMatrixf(mat.get_data());



        _tex_gen_modifies_mat = true;

        glTexGeni(0x2000, 0x2500, 0x8512);
        glTexGeni(0x2001, 0x2500, 0x8512);
        glTexGeni(0x2002, 0x2500, 0x8512);
        glEnable(0x0C60);
        glEnable(0x0C61);
        glEnable(0x0C62);
      }
      break;

    case TexGenAttrib::M_eye_normal:
      if (_supports_cube_map) {



        LMatrix4 mat = _inv_cs_transform->get_mat();
        mat.set_row(3, LVecBase3(0.0f, 0.0f, 0.0f));
        glMatrixMode(0x1702);
        glMultMatrixf(mat.get_data());



        _tex_gen_modifies_mat = true;

        glTexGeni(0x2000, 0x2500, 0x8511);
        glTexGeni(0x2001, 0x2500, 0x8511);
        glTexGeni(0x2002, 0x2500, 0x8511);
        glEnable(0x0C60);
        glEnable(0x0C61);
        glEnable(0x0C62);
      }
      break;

    case TexGenAttrib::M_world_normal:
      if (_supports_cube_map) {





        ConstPointerTo< TransformState > camera_transform = _scene_setup->get_camera_transform()->compose(_inv_cs_transform);

        LMatrix4 mat = camera_transform->get_mat();
        mat.set_row(3, LVecBase3(0.0f, 0.0f, 0.0f));
        glMatrixMode(0x1702);
        glMultMatrixf(mat.get_data());



        _tex_gen_modifies_mat = true;

        glTexGeni(0x2000, 0x2500, 0x8511);
        glTexGeni(0x2001, 0x2500, 0x8511);
        glTexGeni(0x2002, 0x2500, 0x8511);
        glEnable(0x0C60);
        glEnable(0x0C61);
        glEnable(0x0C62);
      }
      break;

    case TexGenAttrib::M_eye_position:


      glMatrixMode(0x1700);
      glPushMatrix();
      call_glLoadMatrix(_cs_transform->get_mat());

      glTexGeni(0x2000, 0x2500, 0x2400);
      glTexGeni(0x2001, 0x2500, 0x2400);
      glTexGeni(0x2002, 0x2500, 0x2400);
      glTexGeni(0x2003, 0x2500, 0x2400);

      glTexGenfv(0x2000, 0x2502, s_data);
      glTexGenfv(0x2001, 0x2502, t_data);
      glTexGenfv(0x2002, 0x2502, r_data);
      glTexGenfv(0x2003, 0x2502, q_data);

      glEnable(0x0C60);
      glEnable(0x0C61);
      glEnable(0x0C62);
      glEnable(0x0C63);

      glMatrixMode(0x1700);
      glPopMatrix();
      break;

    case TexGenAttrib::M_world_position:



      {
        glMatrixMode(0x1700);
        glPushMatrix();
        ConstPointerTo< TransformState > root_transform = _cs_transform->compose(_scene_setup->get_world_transform());
        call_glLoadMatrix(root_transform->get_mat());
        glTexGeni(0x2000, 0x2500, 0x2400);
        glTexGeni(0x2001, 0x2500, 0x2400);
        glTexGeni(0x2002, 0x2500, 0x2400);
        glTexGeni(0x2003, 0x2500, 0x2400);

        glTexGenfv(0x2000, 0x2502, s_data);
        glTexGenfv(0x2001, 0x2502, t_data);
        glTexGenfv(0x2002, 0x2502, r_data);
        glTexGenfv(0x2003, 0x2502, q_data);

        glEnable(0x0C60);
        glEnable(0x0C61);
        glEnable(0x0C62);
        glEnable(0x0C63);

        glMatrixMode(0x1700);
        glPopMatrix();
      }
      break;

    case TexGenAttrib::M_point_sprite:
      if (_supports_point_sprite) {



        glTexEnvi(0x8861, 0x8862, 1);

      }
      break;

    case TexGenAttrib::M_constant:



      {
        const LTexCoord3 &v = _target_tex_gen->get_constant_value(stage);

        glTexGeni(0x2000, 0x2500, 0x2401);
        glTexGeni(0x2001, 0x2500, 0x2401);
        glTexGeni(0x2002, 0x2500, 0x2401);
        glTexGeni(0x2003, 0x2500, 0x2401);

        LVecBase4 s(0.0f, 0.0f, 0.0f, v[0]);
        LVecBase4 t(0.0f, 0.0f, 0.0f, v[1]);
        LVecBase4 r(0.0f, 0.0f, 0.0f, v[2]);

        glTexGenfv(0x2000, 0x2501, s.get_data());
        glTexGenfv(0x2001, 0x2501, t.get_data());
        glTexGenfv(0x2002, 0x2501, r.get_data());
        glTexGenfv(0x2003, 0x2501, q_data);

        glEnable(0x0C60);
        glEnable(0x0C61);
        glEnable(0x0C62);
        glEnable(0x0C63);
      }
      break;

    case TexGenAttrib::M_unused:
      break;
    }

  }

  bool got_point_sprites = _supports_point_sprite &&
    (_target_tex_gen->get_geom_rendering(Geom::GR_point) & GeomEnums::GR_point_sprite) != 0;

  if (got_point_sprites != _tex_gen_point_sprite) {
    _tex_gen_point_sprite = got_point_sprites;







    if (_tex_gen_point_sprite) {
      glEnable(0x8861);
    } else {
      glDisable(0x8861);
    }

  }

  report_my_errors(12626, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
}







bool GLGraphicsStateGuardian::
specify_texture(GLTextureContext *gtc, const SamplerState &sampler) {

  { if ((__builtin_expect(!(gtc->_handle == 0), 0))) { if (Notify::ptr()->assert_failure("gtc->_handle == 0", 12638, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } };


  Texture *tex = gtc->get_texture();

  GLenum target = get_texture_target(tex->get_texture_type());
  if (target == 0) {

    return false;
  }

  if (target == 0x8C2A) {

    return false;
  }



  gtc->_active_sampler = sampler;

  glTexParameteri(target, 0x2802,
                  get_texture_wrap_mode(sampler.get_wrap_u()));

  if (target != 0x0DE0)

  {
    glTexParameteri(target, 0x2803,
                    get_texture_wrap_mode(sampler.get_wrap_v()));
  }

  if (target == 0x806F) {
    glTexParameteri(target, 0x8072,
                    get_texture_wrap_mode(sampler.get_wrap_w()));
  }



  LColor border_color = sampler.get_border_color();
  call_glTexParameterfv(target, 0x1004, border_color);


  SamplerState::FilterType minfilter = sampler.get_effective_minfilter();
  SamplerState::FilterType magfilter = sampler.get_effective_magfilter();
  bool uses_mipmaps = SamplerState::is_mipmap(minfilter) && !gl_ignore_mipmaps;


  if (gl_force_mipmaps) {
    minfilter = SamplerState::FT_linear_mipmap_linear;
    magfilter = SamplerState::FT_linear;
    uses_mipmaps = true;
  }


  if (!tex->might_have_ram_image()) {



    if (!_supports_generate_mipmap) {


      uses_mipmaps = false;
    }
  }

  if (Texture::is_integer(tex->get_format())) {



    glTexParameteri(target, 0x2801,
                    uses_mipmaps ? 0x2700
                                 : 0x2600);
    glTexParameteri(target, 0x2800, 0x2600);
  } else {
    glTexParameteri(target, 0x2801,
                    get_texture_filter_type(minfilter, !uses_mipmaps));
    glTexParameteri(target, 0x2800,
                    get_texture_filter_type(magfilter, true));
  }


  if (_supports_anisotropy) {
    PN_stdfloat anisotropy = sampler.get_effective_anisotropic_degree();
    anisotropy = min(anisotropy, _max_anisotropy);
    anisotropy = max(anisotropy, (PN_stdfloat)1.0);
    glTexParameterf(target, 0x84FE, anisotropy);
  }


  if (tex->get_format() == Texture::F_depth_stencil ||
      tex->get_format() == Texture::F_depth_component ||
      tex->get_format() == Texture::F_depth_component16 ||
      tex->get_format() == Texture::F_depth_component24 ||
      tex->get_format() == Texture::F_depth_component32) {

    if (has_fixed_function_pipeline()) {
      glTexParameteri(target, 0x884B, 0x8049);
    }

    if (_supports_shadow_filter) {
      if ((sampler.get_magfilter() == SamplerState::FT_shadow) ||
          (sampler.get_minfilter() == SamplerState::FT_shadow)) {
        glTexParameteri(target, 0x884C, 0x884E);
        glTexParameteri(target, 0x884D, 0x0203);
      } else {
        glTexParameteri(target, 0x884C, 0);
        glTexParameteri(target, 0x884D, 0x0203);
      }
    }
  }



  if (_supports_texture_lod) {
    glTexParameterf(target, 0x813A, sampler.get_min_lod());
    glTexParameterf(target, 0x813B, sampler.get_max_lod());
  }



  if (_supports_texture_lod_bias) {
    glTexParameterf(target, 0x8501, sampler.get_lod_bias());
  }


  report_my_errors(12762, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");

  if (uses_mipmaps && !gtc->_uses_mipmaps) {


    return true;
  }

  return false;
}





bool GLGraphicsStateGuardian::
apply_texture(GLTextureContext *gtc) {
  gtc->set_active(true);
  GLenum target = get_texture_target(gtc->get_texture()->get_texture_type());
  if (target == 0) {
    return false;
  }

  if (gtc->_target != target) {


    gtc->reset_data();
    gtc->_target = target;
  }

  glBindTexture(target, gtc->_index);
  if (glgsg_cat.is_spam()) {
    glgsg_cat.spam()
      << "glBindTexture(0x" << hex << target << dec << ", " << gtc->_index << "): " << *gtc->get_texture() << "\n";
  }

  report_my_errors(12798, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
  return true;
}
# 12810 "panda/src/glstuff/glGraphicsStateGuardian_src.cxx"
bool GLGraphicsStateGuardian::
apply_sampler(GLuint unit, const SamplerState &sampler, GLTextureContext *gtc) {

  if (_supports_sampler_objects) {


    SamplerContext *sc = sampler.prepare_now(get_prepared_objects(), this);
    { if ((__builtin_expect(!(sc != nullptr), 0))) { if (Notify::ptr()->assert_failure("sc != nullptr", 12817, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } };
    GLSamplerContext *gsc = _dcast((GLSamplerContext*)0, sc);

    gsc->enqueue_lru(&_prepared_objects->_sampler_object_lru);

    _glBindSampler(unit, gsc->_index);

    if (glgsg_cat.is_spam()) {
      glgsg_cat.spam() << "glBindSampler(" << unit << ", "
                   << gsc->_index << "): " << sampler << "\n";
    }

  } else

  {


    if (gtc->_active_sampler != sampler) {
      set_active_texture_stage(unit);
      apply_texture(gtc);
      specify_texture(gtc, sampler);
    }
  }

  if (sampler.uses_mipmaps() && !gtc->_uses_mipmaps && !gl_ignore_mipmaps) {


    glgsg_cat.info()
      << "reloading texture " << gtc->get_texture()->get_name()
      << " with mipmaps\n";

    apply_texture(gtc);
    gtc->mark_needs_reload();
    bool okflag = upload_texture(gtc, false, true);
    if (!okflag) {
      glgsg_cat.error()
        << "Could not load " << *gtc->get_texture() << "\n";
      return false;
    }
  }

  report_my_errors(12858, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
  return true;
}







bool GLGraphicsStateGuardian::
upload_texture(GLTextureContext *gtc, bool force, bool uses_mipmaps) {
  PStatGPUTimer timer(this, _load_texture_pcollector);

  Texture *tex = gtc->get_texture();

  if (_effective_incomplete_render && !force) {
    bool has_image = _supports_compressed_texture ? tex->has_ram_image() : tex->has_uncompressed_ram_image();
    if (!has_image && tex->might_have_ram_image() &&
        tex->has_simple_ram_image() &&
        !_loader.is_null()) {


      async_reload_texture(gtc);
      has_image = _supports_compressed_texture ? tex->has_ram_image() : tex->has_uncompressed_ram_image();
      if (!has_image) {
        if (gtc->was_simple_image_modified()) {
          return upload_simple_texture(gtc);
        }
        return true;
      }
    }
  }

  CPTA_uchar image;
  if (_supports_compressed_texture) {
    image = tex->get_ram_image();
  } else {
    image = tex->get_uncompressed_ram_image();
  }

  Texture::TextureType texture_type = tex->get_texture_type();
  Texture::CompressionMode image_compression;
  if (image.is_null()) {
    image_compression = Texture::CM_off;
  } else {
    image_compression = tex->get_ram_image_compression();

    if (texture_type == Texture::TT_buffer_texture ||
        !get_supports_compressed_texture_format(image_compression)) {
      image = tex->get_uncompressed_ram_image();
      image_compression = Texture::CM_off;



      { if ((__builtin_expect(!(!image.is_null()), 0))) { if (Notify::ptr()->assert_failure("!image.is_null()", 12913, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } };
    }
  }

  int mipmap_bias = 0;

  int width = tex->get_x_size();
  int height = tex->get_y_size();
  int depth = tex->get_z_size();



  bool force_sized = (gl_immutable_texture_storage && _supports_tex_storage) ||
                     (texture_type == Texture::TT_buffer_texture);

  GLint internal_format = get_internal_image_format(tex, force_sized);
  GLint external_format = get_external_image_format(tex);
  GLenum component_type = get_component_type(tex->get_component_type());

  if (glgsg_cat.is_debug()) {
    if (image.is_null()) {
      glgsg_cat.debug()
        << "loading texture with NULL image";
    } else if (image_compression != Texture::CM_off) {
      glgsg_cat.debug()
        << "loading pre-compressed texture";
    } else if (is_compressed_format(internal_format)) {
      glgsg_cat.debug()
        << "loading compressed texture";
    } else {
      glgsg_cat.debug()
        << "loading uncompressed texture";
    }
    glgsg_cat.debug(false) << " " << tex->get_name() << "\n";
  }



  int max_dimension_x;
  int max_dimension_y;
  int max_dimension_z;

  switch (texture_type) {
  case Texture::TT_3d_texture:
    max_dimension_x = _max_3d_texture_dimension;
    max_dimension_y = _max_3d_texture_dimension;
    max_dimension_z = _max_3d_texture_dimension;
    break;

  case Texture::TT_cube_map:
    max_dimension_x = _max_cube_map_dimension;
