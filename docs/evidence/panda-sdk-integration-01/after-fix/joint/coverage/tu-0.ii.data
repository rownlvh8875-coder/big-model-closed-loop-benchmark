bool GLGraphicsStateGuardian::
framebuffer_copy_to_texture(Texture *tex, int view, int z,
                            const DisplayRegion *dr, const RenderBuffer &rb) {
  { if ((__builtin_expect(!(tex != nullptr && dr != nullptr), 0))) { if (Notify::ptr()->assert_failure("tex != nullptr && dr != nullptr", 6966, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } };
  set_read_buffer(rb._buffer_type);
  clear_color_write_mask();

  int xo, yo, w, h;
  dr->get_region_pixels(xo, yo, w, h);
  tex->set_size_padded(w, h, tex->get_z_size());

  if (tex->get_compression() == Texture::CM_default) {


    tex->set_compression(Texture::CM_off);
  }


  if (z >= 0) {
    if (z >= tex->get_z_size()) {


      return false;
    }

    if ((w != tex->get_x_size()) ||
        (h != tex->get_y_size())) {
      return false;
    }

    if (tex->get_texture_type() == Texture::TT_cube_map) {
      if (!_supports_cube_map) {
        return false;
      }

      { if ((__builtin_expect(!(z < 6), 0))) { if (Notify::ptr()->assert_failure("z < 6", 6998, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } };
      if (w != h) {
        return false;
      }

    } else if (tex->get_texture_type() == Texture::TT_3d_texture) {
      if (!_supports_3d_texture) {
        return false;
      }

    } else if (tex->get_texture_type() == Texture::TT_2d_texture_array) {
      if (!_supports_2d_texture_array) {
        return false;
      }

    } else {
      glgsg_cat.error()
        << "Don't know how to copy framebuffer to texture " << *tex << "\n";
    }
  } else {
    { if ((__builtin_expect(!(tex->get_texture_type() == Texture::TT_2d_texture), 0))) { if (Notify::ptr()->assert_failure("tex->get_texture_type() == Texture::TT_2d_texture", 7018, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } };
  }


  if (tex->get_match_framebuffer_format()) {

    switch (tex->get_format()) {
    case Texture::F_depth_component:
    case Texture::F_depth_component16:
    case Texture::F_depth_component24:
    case Texture::F_depth_component32:
    case Texture::F_depth_stencil:

      break;

    default:


      if (_current_properties->get_srgb_color()) {
        if (_current_properties->get_alpha_bits()) {
          tex->set_format(Texture::F_srgb_alpha);
        } else {
          tex->set_format(Texture::F_srgb);
        }
      } else {
        if (_current_properties->get_alpha_bits()) {
          tex->set_format(Texture::F_rgba);
        } else {
          tex->set_format(Texture::F_rgb);
        }
      }
    }
  }

  TextureContext *tc = tex->prepare_now(view, get_prepared_objects(), this);
  { if ((__builtin_expect(!(tc != nullptr), 0))) { if (Notify::ptr()->assert_failure("tc != nullptr", 7053, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } };
  GLTextureContext *gtc = _dcast((GLTextureContext*)0, tc);

  apply_texture(gtc);
  bool needs_reload = specify_texture(gtc, tex->get_default_sampler());

  GLenum target = get_texture_target(tex->get_texture_type());
  GLint internal_format = get_internal_image_format(tex);
  int width = tex->get_x_size();
  int height = tex->get_y_size();
  int depth = tex->get_z_size();

  bool uses_mipmaps = tex->uses_mipmaps() && !gl_ignore_mipmaps;
  if (uses_mipmaps) {
    if (_supports_generate_mipmap) {

      if (_glGenerateMipmap == nullptr) {
        glTexParameteri(target, 0x8191, true);
      }

    } else {

      glTexParameteri(target, 0x2801, 0x2601);
      uses_mipmaps = false;
    }
  }

  bool new_image = needs_reload || gtc->was_image_modified();

  if (z >= 0) {
    if (target == 0x8513) {

      target = 0x8515 + z;
      depth = 1;
      z = -1;



      new_image = true;
    }
  }

  if (!gtc->_has_storage ||
      internal_format != gtc->_internal_format ||
      uses_mipmaps != gtc->_uses_mipmaps ||
      width != gtc->_width ||
      height != gtc->_height ||
      depth != gtc->_depth) {

    new_image = true;
  }

  if (new_image && gtc->_immutable) {
    gtc->reset_data();
    glBindTexture(target, gtc->_index);

    if (glgsg_cat.is_spam()) {
      glgsg_cat.spam()
        << "glBindTexture(0x" << hex << target << dec << ", " << gtc->_index << "): " << *tex << "\n";
    }
  }


  if (gtc->needs_barrier(0x00000100)) {

    issue_memory_barrier(0x00000100);
  }


  if (z >= 0) {

    if (new_image) {


      GLint external_format = get_external_image_format(tex);
      GLint component_type = get_component_type(tex->get_component_type());
      _glTexImage3D(target, 0, internal_format, width, height, depth, 0, external_format, component_type, nullptr);
    }

    _glCopyTexSubImage3D(target, 0, 0, 0, z, xo, yo, w, h);

  } else {
    if (new_image) {



      glCopyTexImage2D(target, 0, internal_format, xo, yo, width, height, 0);
    } else {

      glCopyTexSubImage2D(target, 0, 0, 0, xo, yo, w, h);
    }
  }

  if (uses_mipmaps && _glGenerateMipmap != nullptr) {
    glEnable(target);
    _glGenerateMipmap(target);
    glDisable(target);
  }

  gtc->_has_storage = true;
  gtc->_uses_mipmaps = uses_mipmaps;
  gtc->_internal_format = internal_format;
  gtc->_width = width;
  gtc->_height = height;
  gtc->_depth = depth;

  gtc->mark_loaded();
  gtc->enqueue_lru(&_prepared_objects->_graphics_memory_lru);

  report_my_errors(7162, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");


  _state_mask.clear_bit(TextureAttrib::get_class_slot());

  return true;
}
