inline int TextureAttrib::
get_num_off_stages() const {
  return _off_stages.size();
}





inline TextureStage *TextureAttrib::
get_off_stage(int n) const {
  { if ((__builtin_expect(!(n >= 0 && n < (int)_off_stages.size()), 0))) { if (Notify::ptr()->assert_failure("n >= 0 && n < (int)_off_stages.size()", 186, "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/textureAttrib.I")) { return nullptr; } } };
