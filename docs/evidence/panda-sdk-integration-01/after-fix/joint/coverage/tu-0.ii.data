unlock(FutureState new_state) {
  { if ((__builtin_expect(!(new_state != FS_locked_pending), 0))) { if (Notify::ptr()->assert_failure("new_state != FS_locked_pending", 151, "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/asyncFuture.I")) { return; } } };
  FutureState orig_state = (FutureState)AtomicAdjust::set(_future_state, (AtomicAdjust::Integer)new_state);
  { if ((__builtin_expect(!(orig_state == FS_locked_pending), 0))) { if (Notify::ptr()->assert_failure("orig_state == FS_locked_pending", 153, "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/asyncFuture.I")) { return; } } };
}







inline bool AsyncFuture::
set_future_state(FutureState state) {
  FutureState orig_state = (FutureState)
    AtomicAdjust::compare_and_exchange(
      _future_state,
      (AtomicAdjust::Integer)FS_pending,
      (AtomicAdjust::Integer)state);

  while (orig_state == FS_locked_pending) {
    Thread::force_yield();
    orig_state = (FutureState)AtomicAdjust::compare_and_exchange(
      _future_state,
      (AtomicAdjust::Integer)FS_pending,
      (AtomicAdjust::Integer)state);
  }

  return orig_state == FS_pending;
}




