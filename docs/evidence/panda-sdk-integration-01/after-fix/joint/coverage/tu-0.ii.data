}




void GLGraphicsStateGuardian::
generate_mipmaps(GLTextureContext *gtc) {

  if (_supports_dsa) {

    _glGenerateTextureMipmap(gtc->_index);
    return;
  }


  if (_glGenerateMipmap != nullptr) {
    _state_texture = 0;
    update_texture(gtc, true);
    apply_texture(gtc);
    _glGenerateMipmap(gtc->_target);
    glBindTexture(gtc->_target, 0);
  }
}







bool GLGraphicsStateGuardian::
upload_simple_texture(GLTextureContext *gtc) {
  report_my_errors(13872, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");

  PStatGPUTimer timer(this, _load_texture_pcollector);
  Texture *tex = gtc->get_texture();
  { if ((__builtin_expect(!(tex != nullptr), 0))) { if (Notify::ptr()->assert_failure("tex != nullptr", 13876, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } };




  GLenum internal_format = 0x1908;

  GLenum external_format = 0x80E1;

  CPTA_uchar image = tex->get_simple_ram_image();
  const unsigned char *image_ptr = image.p();
  if (image_ptr == nullptr) {
    return false;
  }

  size_t image_size = tex->get_simple_ram_image_size();
  PTA_uchar bgr_image;
  if (!_supports_bgr) {


    external_format = 0x1908;



    image_ptr = fix_component_ordering(bgr_image, image_ptr, image_size,
                                       external_format, tex);
  }

  int width = tex->get_simple_x_size();
  int height = tex->get_simple_y_size();
  GLenum component_type = 0x1401;

  if (glgsg_cat.is_debug()) {
    glgsg_cat.debug()
      << "loading simple image for " << tex->get_name() << "\n";
  }


  if (tex->uses_mipmaps() && _supports_texture_max_level) {
    glTexParameteri(0x0DE1, 0x813D, 0);
  }


  _data_transferred_pcollector.add_level(image_size);





  glTexImage2D(0x0DE1, 0, internal_format,
               width, height, 0,
               external_format, component_type, image_ptr);

  gtc->mark_simple_loaded();

  report_my_errors(13931, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
  return true;
}





size_t GLGraphicsStateGuardian::
get_texture_memory_size(GLTextureContext *gtc) {
  Texture *tex = gtc->get_texture();
# 13951 "panda/src/glstuff/glGraphicsStateGuardian_src.cxx"
  GLenum target = get_texture_target(tex->get_texture_type());

  GLenum page_target = target;
  GLint scale = 1;
  if (target == 0x8513) {

    page_target = 0x8515;
    scale = 6;

  } else if (target == 0x8C2A) {



    return tex->get_expected_ram_image_size();
  }

  clear_my_errors(13967, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");

  GLint internal_format;
  glGetTexLevelParameteriv(page_target, 0, 0x1003, &internal_format);

  if (is_compressed_format(internal_format)) {

    GLint image_size;
    glGetTexLevelParameteriv(page_target, 0,
                                0x86A0, &image_size);

    GLenum error_code = gl_get_error();
    if (error_code != 0) {
      if (glgsg_cat.is_debug()) {
        glgsg_cat.debug()
          << "Couldn't get compressed size for " << tex->get_name()
          << " : " << get_error_string(error_code) << "\n";
      }

    } else {
      return image_size * scale;
    }
  }


  GLint red_size, green_size, blue_size, alpha_size;
  GLint depth_size = 0, luminance_size = 0, intensity_size = 0;
  glGetTexLevelParameteriv(page_target, 0,
                           0x805C, &red_size);
  glGetTexLevelParameteriv(page_target, 0,
                           0x805D, &green_size);
  glGetTexLevelParameteriv(page_target, 0,
                           0x805E, &blue_size);
  glGetTexLevelParameteriv(page_target, 0,
                           0x805F, &alpha_size);
  if (get_supports_luminance_texture()) {
    glGetTexLevelParameteriv(page_target, 0,
                             0x8060, &luminance_size);
    glGetTexLevelParameteriv(page_target, 0,
                             0x8061, &intensity_size);
  }
  if (get_supports_depth_texture()) {
    glGetTexLevelParameteriv(page_target, 0,
                             0x884A, &depth_size);
  }

  GLint width = 1, height = 1, depth = 1;
  glGetTexLevelParameteriv(page_target, 0, 0x1000, &width);
  glGetTexLevelParameteriv(page_target, 0, 0x1001, &height);
  if (_supports_3d_texture || _supports_2d_texture_array) {
    glGetTexLevelParameteriv(page_target, 0, 0x8071, &depth);
  }

  report_my_errors(14020, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");

  size_t num_bits = (red_size + green_size + blue_size + alpha_size + luminance_size + intensity_size + depth_size);
  size_t num_bytes = (num_bits + 7) / 8;


  size_t result = num_bytes * width * height * depth * scale;
  if (gtc->_uses_mipmaps) {
    result = (result * 4) / 3;
  }

  return result;
}





