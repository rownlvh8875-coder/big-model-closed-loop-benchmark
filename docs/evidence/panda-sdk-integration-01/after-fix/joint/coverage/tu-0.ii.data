template<class ObjectType>
class IndirectCompareTo {
public:
  inline bool operator () (const ObjectType *a, const ObjectType *b) const;
};

# 1 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/indirectCompareTo.I" 1
# 17 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/indirectCompareTo.I"
template<class ObjectType>
inline bool IndirectCompareTo<ObjectType>::
operator () (const ObjectType *a, const ObjectType *b) const {
  return (a != b && a->compare_to(*b) < 0);
}
