}





inline NodePath CullTraverserData::
get_node_path() const {
  NodePath result;
  result._head = r_get_node_path();
  { if ((__builtin_expect(!(result._head != nullptr), 0))) { if (Notify::ptr()->assert_failure("result._head != nullptr", 94, "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/cullTraverserData.I")) { return NodePath::fail(); } } };
  return result;
}





inline ConstPointerTo< TransformState > CullTraverserData::
