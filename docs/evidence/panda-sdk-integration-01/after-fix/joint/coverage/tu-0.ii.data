inline float LVector3f::
signed_angle_deg(const LVector3f &other,
                 const LVector3f &ref) const {
  return rad_2_deg(signed_angle_rad(other, ref));
}




inline float LVector3f::
relative_angle_rad(const LVector3f &other) const {
  return atan2((_v(0)*other._v(1))-(_v(1)*other._v(0)), dot(other));
}




inline float LVector3f::
relative_angle_deg(const LVector3f &other) const {
  return relative_angle_rad(other) * 180.0f / 3.1415926535f;
}





