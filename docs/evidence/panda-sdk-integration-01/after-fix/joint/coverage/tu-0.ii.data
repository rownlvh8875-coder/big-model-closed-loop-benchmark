inline LMatrix4f LQuaternionf::
operator *(const LMatrix4f &m) {
  LMatrix3f m_upper_3 = m.get_upper_3();
  LMatrix3f this_quat;
  extract_to_matrix(this_quat);

  LMatrix4f result;
  result.set_upper_3(this_quat * m_upper_3);
  result.set_row(3, m.get_row(3));
  result.set_col(3, m.get_col(3));

  return result;
}





