inline LVector3f LVector3f::
up(CoordinateSystem cs) {
  if (cs == CS_default) {
    cs = get_default_coordinate_system();
  }
  switch (cs) {
  case CS_zup_right:
  case CS_zup_left:
    return LVector3f(0, 0, 1);

  case CS_yup_right:
  case CS_yup_left:
    return LVector3f(0, 1, 0);

  default:
    linmath_cat.error()
      << "Invalid coordinate system!\n";
    return LVector3f(0, 0, 0);
  }
}




inline LVector3f LVector3f::
right(CoordinateSystem) {
  return LVector3f(1, 0, 0);
}




inline LVector3f LVector3f::
forward(CoordinateSystem cs) {
  if (cs == CS_default) {
    cs = get_default_coordinate_system();
  }
  switch (cs) {
  case CS_zup_right:
    return LVector3f(0, 1, 0);

  case CS_zup_left:
    return LVector3f(0, -1, 0);

  case CS_yup_right:
    return LVector3f(0, 0, -1);

  case CS_yup_left:
    return LVector3f(0, 0, 1);

  default:
    linmath_cat.error()
      << "Invalid coordinate system!\n";
    return LVector3f(0, 0, 0);
  }
}




inline LVector3f LVector3f::
down(CoordinateSystem cs) {
  return -up(cs);
}




inline LVector3f LVector3f::
left(CoordinateSystem cs) {
  return -right(cs);
}




inline LVector3f LVector3f::
back(CoordinateSystem cs) {
  return -forward(cs);
}





inline LVector3f LVector3f::
rfu(float right_v, float fwd_v, float up_v,
    CoordinateSystem cs) {




  if (cs == CS_default) {
    cs = get_default_coordinate_system();
  }

  float vy, vz;
  switch(cs) {
  case CS_yup_right:
    vz = -fwd_v;
    vy = up_v;
    break;

  case CS_yup_left:
    vz = fwd_v;
    vy = up_v;
    break;

  case CS_zup_right:
    vy = fwd_v;
    vz = up_v;
    break;

  case CS_zup_left:
    vy = -fwd_v;
    vz = up_v;
    break;

  default:
    linmath_cat.error()
      << "Invalid coordinate system!\n";
    return LVector3f(0);
  }

  return LVector3f(right_v, vy, vz);
}
