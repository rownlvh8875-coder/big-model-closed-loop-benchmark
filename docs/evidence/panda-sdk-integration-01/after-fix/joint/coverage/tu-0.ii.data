inline bool LPlanef::
intersects_line(LPoint3f &intersection_point,
                const LPoint3f &p1,
                const LPoint3f &p2) const {
  float t;
  if (!intersects_line(t, p1, p2 - p1)) {
    return false;
  }
  intersection_point = p1 + t * (p2 - p1);
  return true;
}
# 222 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/plane_src.I"
inline bool LPlanef::
intersects_line(float &t,
                const LPoint3f &from,
                const LVector3f &delta) const {
  float denom = ::dot(get_normal(), delta);
  if ((((denom) < (get_nearly_zero_value(denom)) && (denom) > -(get_nearly_zero_value(denom))))) {
    t = 0.0f;
    return false;
  }

  t = -(dist_to_plane(from) / denom);
  return true;
}

