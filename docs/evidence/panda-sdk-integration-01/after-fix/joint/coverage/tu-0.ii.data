# 17 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/glGraphicsStateGuardian_src.I"
inline void GLGraphicsStateGuardian::
push_group_marker(const std::string &marker) {

  if (_glPushGroupMarker != nullptr) {
    _glPushGroupMarker(marker.size(), marker.data());
  }

}




inline void GLGraphicsStateGuardian::
pop_group_marker() {

  if (_glPopGroupMarker != nullptr) {
    _glPopGroupMarker();
  }

}
# 46 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/glGraphicsStateGuardian_src.I"
inline bool GLGraphicsStateGuardian::
report_errors(int line, const char *source_file) {

  PStatTimer timer(_check_error_pcollector);
  GLenum error_code = glGetError();
  if (error_code != 0) {
    int error_count = 0;
    return report_errors_loop(line, source_file, error_code, error_count);
  }

  return true;
}





inline void GLGraphicsStateGuardian::
report_my_errors(int line, const char *source_file) {

  if (_check_errors) {
    PStatTimer timer(_check_error_pcollector);
    GLenum error_code = glGetError();
    if (error_code != 0) {
      if (!report_errors_loop(line, source_file, error_code, _error_count)) {
        panic_deactivate();
      }
    }
  }

}
# 86 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/glGraphicsStateGuardian_src.I"
inline bool GLGraphicsStateGuardian::
clear_errors(int line, const char *source_file) {
  PStatTimer timer(_check_error_pcollector);
  GLenum error_code = glGetError();
  if (error_code != 0) {
    int error_count = 0;
    return report_errors_loop(line, source_file, error_code, error_count);
  }

  return true;
}
# 105 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/glGraphicsStateGuardian_src.I"
inline void GLGraphicsStateGuardian::
clear_my_errors(int line, const char *source_file) {
  if (_check_errors) {
    PStatTimer timer(_check_error_pcollector);
    GLenum error_code = glGetError();
    if (error_code != 0) {
      int error_count = 0;
      report_errors_loop(line, source_file, error_code, error_count);
    }
  }
