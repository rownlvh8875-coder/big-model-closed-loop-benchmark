class ConfigVariableBool : public ConfigVariable {
public:
  inline ConfigVariableBool(const std::string &name);
  inline ConfigVariableBool(const std::string &name, bool default_value,
                            const std::string &description = std::string(), int flags = 0);
  inline ConfigVariableBool(const std::string &name, const std::string &default_value,
                            const std::string &description = std::string(), int flags = 0);

  inline void operator = (bool value);
  __attribute__((always_inline)) inline operator bool () const;

  inline size_t size() const;
  inline bool operator [] (size_t n) const;

  inline void set_value(bool value);
  __attribute__((always_inline)) inline bool get_value() const;
  inline bool get_default_value() const;
  ;
  ;

  inline bool get_word(size_t n) const;
  inline void set_word(size_t n, bool value);

private:
  void reload_value() const;

  mutable AtomicAdjust::Integer _local_modified;
  mutable bool _cache;
};

# 1 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/configVariableBool.I" 1
# 17 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/configVariableBool.I"
inline ConfigVariableBool::
ConfigVariableBool(const std::string &name) :
  ConfigVariable(name, VT_bool),
  _local_modified(initial_invalid_cache())
{
  _core->set_used();
}




inline ConfigVariableBool::
ConfigVariableBool(const std::string &name, bool default_value,
                   const std::string &description, int flags) :

  ConfigVariable(name, VT_bool, description, flags),



  _local_modified(initial_invalid_cache())
{
  _core->set_default_value(default_value ? "1" : "0");
  _core->set_used();
}




inline ConfigVariableBool::
ConfigVariableBool(const std::string &name, const std::string &default_value,
                   const std::string &description, int flags) :

  ConfigVariable(name, VT_bool, description, flags),



  _local_modified(initial_invalid_cache())
{
  _core->set_default_value(default_value);
  _core->set_used();
}




inline void ConfigVariableBool::
operator = (bool value) {
  set_value(value);
}




__attribute__((always_inline)) inline ConfigVariableBool::
operator bool () const {
  return get_value();
}




inline size_t ConfigVariableBool::
size() const {
  return get_num_words();
}




inline bool ConfigVariableBool::
operator [] (size_t n) const {
  return get_word(n);
}




inline void ConfigVariableBool::
set_value(bool value) {
  set_string_value("");
  set_bool_word(0, value);
}




__attribute__((always_inline)) inline bool ConfigVariableBool::
get_value() const {
  ;
  if (!is_cache_valid(_local_modified)) {
    reload_value();
  }
  return _cache;
}




inline bool ConfigVariableBool::
get_default_value() const {
  const ConfigDeclaration *decl = ConfigVariable::get_default_value();
  if (decl != nullptr) {
    return decl->get_bool_word(0);
  }
  return false;
}




inline bool ConfigVariableBool::
get_word(size_t n) const {
  return get_bool_word(n);
}





inline void ConfigVariableBool::
set_word(size_t n, bool value) {
  set_bool_word(n, value);
}
