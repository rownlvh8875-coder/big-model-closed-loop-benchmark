void GLGraphicsStateGuardian::
do_issue_material() {
  static Material empty;
  const Material *material;

  const MaterialAttrib *target_material;
  _target_rs->get_attrib_def(target_material);

  if (target_material == nullptr ||
      target_material->is_off()) {
    material = &empty;
  } else {
    material = target_material->get_material();
  }

  bool has_material_force_color = _has_material_force_color;


  if (_show_texture_usage) {



    material = &empty;
    has_material_force_color = false;
  }





  GLenum face = material->get_twoside() ? 0x0408 : 0x0404;


  call_glMaterialfv(face, 0x1202, material->get_specular());
  call_glMaterialfv(face, 0x1600, material->get_emission());
  glMaterialf(face, 0x1601, max(min(material->get_shininess(), (PN_stdfloat)128), (PN_stdfloat)0));

  if ((material->has_ambient() && material->has_diffuse()) || material->has_base_color()) {


    glDisable(0x0B57);
    call_glMaterialfv(face, 0x1200, material->get_ambient());
    call_glMaterialfv(face, 0x1201, material->get_diffuse());

  } else if (material->has_ambient()) {


    if (has_material_force_color) {
      glDisable(0x0B57);
      call_glMaterialfv(face, 0x1201, _material_force_color);
    } else {

      glColorMaterial(face, 0x1201);

      glEnable(0x0B57);
    }
    call_glMaterialfv(face, 0x1200, material->get_ambient());

  } else if (material->has_diffuse()) {


    if (has_material_force_color) {
      glDisable(0x0B57);
      call_glMaterialfv(face, 0x1200, _material_force_color);
    } else {

      glColorMaterial(face, 0x1200);

      glEnable(0x0B57);
    }
    call_glMaterialfv(face, 0x1201, material->get_diffuse());

  } else {


    if (has_material_force_color) {
      glDisable(0x0B57);
      call_glMaterialfv(face, 0x1200, _material_force_color);
      call_glMaterialfv(face, 0x1201, _material_force_color);
    } else {

      glColorMaterial(face, 0x1602);

      glEnable(0x0B57);
    }
  }


  glLightModeli(0x0B51, material->get_local());
  glLightModeli(0x0B52, material->get_twoside());

  if (_use_separate_specular_color) {
    glLightModeli(0x81F8, 0x81FA);
  } else {
    glLightModeli(0x81F8, 0x81F9);
  }


  report_my_errors(8086, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
}






