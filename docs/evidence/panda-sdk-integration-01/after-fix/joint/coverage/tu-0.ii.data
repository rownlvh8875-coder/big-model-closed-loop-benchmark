# 37 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/memoryHook.h"
class MemoryHook {
public:
  MemoryHook();
  MemoryHook(const MemoryHook &copy);
  virtual ~MemoryHook();

  virtual void *heap_alloc_single(size_t size);
  virtual void heap_free_single(void *ptr);

  virtual void *heap_alloc_array(size_t size);
  virtual void *heap_realloc_array(void *ptr, size_t size);
  virtual void heap_free_array(void *ptr);

  inline void inc_heap(size_t size);
  inline void dec_heap(size_t size);

  bool heap_trim(size_t pad);

  constexpr static size_t get_memory_alignment() {
    return 16;
  }

  virtual void *mmap_alloc(size_t size, bool allow_exec);
  virtual void mmap_free(void *ptr, size_t size);
  inline size_t get_page_size() const;
  inline size_t round_up_to_page_size(size_t size) const;

  virtual void mark_pointer(void *ptr, size_t orig_size, ReferenceCount *ref_ptr);

  DeletedBufferChain *get_deleted_chain(size_t buffer_size);

  virtual void alloc_fail(size_t attempted_size);

  inline static size_t get_ptr_size(void *ptr);

protected:
  volatile AtomicAdjust::Integer _total_heap_single_size;
  volatile AtomicAdjust::Integer _total_heap_array_size;
  volatile AtomicAdjust::Integer _requested_heap_size;
  volatile AtomicAdjust::Integer _total_mmap_size;



  size_t _max_heap_size;

  virtual void overflow_heap_size();

private:
  size_t _page_size;

  typedef std::map<size_t, DeletedBufferChain *> DeletedChains;
  DeletedChains _deleted_chains;

  mutable MutexImpl _lock;
};

# 1 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/memoryHook.I" 1
# 18 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/memoryHook.I"
inline void MemoryHook::
inc_heap(size_t size) {

  AtomicAdjust::add(_requested_heap_size, (AtomicAdjust::Integer)size);

}





inline void MemoryHook::
dec_heap(size_t size) {


  AtomicAdjust::add(_requested_heap_size, -(AtomicAdjust::Integer)size);

}





inline size_t MemoryHook::
get_page_size() const {
  return _page_size;
}





inline size_t MemoryHook::
round_up_to_page_size(size_t size) const {
  return ((size + _page_size - 1) / _page_size) * _page_size;
}
