inline LPlaned::
LPlaned() {
  _v(0) = 0.0f;
  _v(1) = 0.0f;
  _v(2) = 1.0f;
  _v(3) = 0.0f;
}




inline LPlaned::
LPlaned(const LVecBase4d &copy) :
  LVecBase4d(copy)
{
}






inline LPlaned::
LPlaned(const LPoint3d &a, const LPoint3d &b,
                 const LPoint3d &c) {
  LVector3d u = b - a;
  LVector3d v = c - a;
  LVector3d p = ::normalize(cross(u, v));

  _v(0) = p[0];
  _v(1) = p[1];
  _v(2) = p[2];
  _v(3) = -::dot(p, a);
}





inline LPlaned::
LPlaned(const LVector3d &normal,
                 const LPoint3d &point) {
  LVector3d p = ::normalize(normal);

  _v(0) = p[0];
  _v(1) = p[1];
  _v(2) = p[2];
  _v(3) = -::dot(p, point);
}




inline LPlaned::
LPlaned(double a, double b, double c, double d) :
  LVecBase4d(a, b, c, d)
{
}




inline LPlaned LPlaned::
operator * (const LMatrix3d &mat) const {
  LVector3d new_normal = mat.xform(get_normal());
  return LPlaned(new_normal, get_point());
}




inline LPlaned LPlaned::
operator * (const LMatrix4d &mat) const {
  LVector3d new_normal = mat.xform_vec_general(get_normal());
  LPoint3d new_point = get_point() * mat;
  return LPlaned(new_normal, new_point);
}




inline void LPlaned::
operator *= (const LMatrix4d &mat) {
  (*this) = (*this) * mat;
}




inline void LPlaned::
xform(const LMatrix4d &mat) {
  (*this) = (*this) * mat;
}




inline LPlaned LPlaned::
operator - () const {
  return LPlaned(-_v(0), -_v(1), -_v(2), -_v(3));
}




inline LVector3d LPlaned::
get_normal() const {
  return LVector3d(_v(0), _v(1), _v(2));
}
# 135 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/plane_src.I"
inline double LPlaned::
dist_to_plane(const LPoint3d &point) const {
  return (_v(0) * point[0] + _v(1) * point[1] + _v(2) * point[2] + _v(3));
}





inline bool LPlaned::
normalize() {
  double l2 = get_normal().length_squared();
  if (l2 == (double)0.0f) {
    return false;

  } else if (!((((l2) - (1.0f)) < ((get_nearly_zero_value((double)0)) * (get_nearly_zero_value((double)0))) && ((l2) - (1.0f)) > -((get_nearly_zero_value((double)0)) * (get_nearly_zero_value((double)0)))))) {
    (*this) /= csqrt(l2);
  }

  return true;
}





inline LPlaned LPlaned::
normalized() const {
  double l2 = get_normal().length_squared();
  if (l2 != (double)0.0f) {
    return (*this) / csqrt(l2);
  } else {
    return (*this);
  }
}




inline LPoint3d LPlaned::
project(const LPoint3d &point) const {
  return point - get_normal() * dist_to_plane(point);
}





inline void LPlaned::
flip() {
  _v(0) = -_v(0);
  _v(1) = -_v(1);
  _v(2) = -_v(2);
  _v(3) = -_v(3);
}
# 198 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/plane_src.I"
inline bool LPlaned::
intersects_line(LPoint3d &intersection_point,
                const LPoint3d &p1,
                const LPoint3d &p2) const {
  double t;
  if (!intersects_line(t, p1, p2 - p1)) {
    return false;
  }
  intersection_point = p1 + t * (p2 - p1);
  return true;
}
# 222 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/plane_src.I"
inline bool LPlaned::
intersects_line(double &t,
                const LPoint3d &from,
                const LVector3d &delta) const {
  double denom = ::dot(get_normal(), delta);
  if ((((denom) < (get_nearly_zero_value(denom)) && (denom) > -(get_nearly_zero_value(denom))))) {
    t = 0.0f;
    return false;
  }

  t = -(dist_to_plane(from) / denom);
  return true;
}

inline std::ostream &
operator << (std::ostream &out, const LPlaned &p) {
  p.output(out);
  return out;
}
