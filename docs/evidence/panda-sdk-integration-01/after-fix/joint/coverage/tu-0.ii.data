void GLGraphicsStateGuardian::
apply_fog(Fog *fog) {
  Fog::Mode fmode = fog->get_mode();
  glFogf(0x0B65, get_fog_mode_type(fmode));

  if (fmode == Fog::M_linear) {
    PN_stdfloat onset, opaque;
    fog->get_linear_range(onset, opaque);
    glFogf(0x0B63, onset);
    glFogf(0x0B64, opaque);

  } else {

    glFogf(0x0B62, fog->get_exp_density());
  }

  call_glFogfv(0x0B66, fog->get_color());
  report_my_errors(7518, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
}
