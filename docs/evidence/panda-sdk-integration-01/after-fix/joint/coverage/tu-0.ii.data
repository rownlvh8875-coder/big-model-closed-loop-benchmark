  report_my_errors(1789, "panda/src/glstuff/glGraphicsBuffer_src.cxx");


  _gsg.clear();

  _is_valid = false;
}





bool GLGraphicsBuffer::
share_depth_buffer(GraphicsOutput *graphics_output) {

  bool state;
  GLGraphicsBuffer *input_graphics_output;

  state = false;
  input_graphics_output = _dcast((GLGraphicsBuffer*)0, graphics_output);
  if (this != input_graphics_output && input_graphics_output) {

    state = true;
    this->unshare_depth_buffer();


    if (!input_graphics_output->is_of_type(GLGraphicsBuffer::get_class_type())) {
      glgsg_cat.error() << "share_depth_buffer: non-matching type\n";
      state = false;
    }


    if (this->get_x_size() != input_graphics_output->get_x_size()) {
      glgsg_cat.error() << "share_depth_buffer: non-matching width\n";
      state = false;
    }

    if (this->get_y_size() != input_graphics_output->get_y_size()) {
      glgsg_cat.error() << "share_depth_buffer: non-matching height\n";
      state = false;
    }


    if (this->get_multisample_count() != input_graphics_output->get_multisample_count()) {
      glgsg_cat.error() << "share_depth_buffer: non-matching multisamples\n";
      state = false;
    }

    if (this->get_coverage_sample_count() != input_graphics_output->get_coverage_sample_count()) {
      glgsg_cat.error() << "share_depth_buffer: non-matching coverage samples\n";
      state = false;
    }

    if (state) {


      input_graphics_output->register_shared_depth_buffer(this);
      _shared_depth_buffer = input_graphics_output;
      state = true;
    }
    _needs_rebuild = true;
  }
  report_my_errors(1851, "panda/src/glstuff/glGraphicsBuffer_src.cxx");
  return state;
}




void GLGraphicsBuffer::
unshare_depth_buffer() {
  if (_shared_depth_buffer) {


    _shared_depth_buffer->unregister_shared_depth_buffer(this);
    _shared_depth_buffer = 0;
    _needs_rebuild = true;
  }
}






bool GLGraphicsBuffer::
get_supports_render_texture() const {

  return true;
}




void GLGraphicsBuffer::
register_shared_depth_buffer(GraphicsOutput *graphics_output) {
  GLGraphicsBuffer *input_graphics_output;

  input_graphics_output = _dcast((GLGraphicsBuffer*)0, graphics_output);
  if (input_graphics_output) {

    _shared_depth_buffer_list.push_back(input_graphics_output);
  }
}




void GLGraphicsBuffer::
unregister_shared_depth_buffer(GraphicsOutput *graphics_output) {
  GLGraphicsBuffer *input_graphics_output;

  input_graphics_output = _dcast((GLGraphicsBuffer*)0, graphics_output);
  if (input_graphics_output) {

    _shared_depth_buffer_list.remove(input_graphics_output);
  }
}




void GLGraphicsBuffer::
report_my_errors(int line, const char *file) {
  if (_gsg == 0) {
    GLenum error_code = psd::call<PSD_GET_ERROR>(glGetError);
    if (error_code != 0) {
      glgsg_cat.error() << file << ", line " << line << ": GL error " << (int)error_code << "\n";
    }
  } else {
    GLGraphicsStateGuardian *glgsg = (GLGraphicsStateGuardian *)_gsg.p();
    glgsg->report_my_errors(line, file);
  }
}




void GLGraphicsBuffer::
check_host_valid() {
  if (_host != nullptr && !_host->is_valid()) {
    _rb_data_size_bytes = 0;
    if (_rb_context != nullptr) {


      _rb_context->update_data_size_bytes(0);
      delete _rb_context;
      _rb_context = nullptr;
    }
    _is_valid = false;
    _gsg.clear();
    _host.clear();
  }
}





