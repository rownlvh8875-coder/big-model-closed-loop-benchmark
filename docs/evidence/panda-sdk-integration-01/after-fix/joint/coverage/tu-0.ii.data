class TypeHandle final {
public:
  TypeHandle() noexcept = default;

  enum MemoryClass {
    MC_singleton,
    MC_array,
    MC_deleted_chain_active,
    MC_deleted_chain_inactive,

    MC_limit

  };






  ;

