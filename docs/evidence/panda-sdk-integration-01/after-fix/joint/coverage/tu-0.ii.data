inline int RenderEffect::
compare_to(const RenderEffect &other) const {


  TypeHandle type = get_type();
  TypeHandle other_type = other.get_type();
  if (type != other_type) {
    return type.get_index() - other_type.get_index();
  }


  return compare_to_impl(&other);
}
