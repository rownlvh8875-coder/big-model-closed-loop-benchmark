  template<class Y>
  __attribute__((always_inline)) inline WeakPointerTo(const WeakPointerTo<Y> &r) noexcept;
  template<class Y>
  __attribute__((always_inline)) inline WeakPointerTo(const PointerTo<Y> &r) noexcept;
  template<class Y>
  __attribute__((always_inline)) inline WeakPointerTo(WeakPointerTo<Y> &&r) noexcept;

  inline To &operator *() const;
  inline To *operator -> () const;

  inline explicit operator T *() const;

public:
  inline PointerTo<T> lock() const;
  inline To *p() const;
  inline To *get_orig() const;

  inline WeakPointerTo<T> &operator = (To *ptr);
  inline WeakPointerTo<T> &operator = (const PointerTo<T> &copy);
  inline WeakPointerTo<T> &operator = (const WeakPointerTo<T> &copy);

public:
  inline WeakPointerTo<T> &operator = (WeakPointerTo<T> &&from) noexcept;

  template<class Y>
