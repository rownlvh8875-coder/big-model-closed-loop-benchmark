                                components[11]);
  compose_matrix(mat, scale, shear, hpr, translate, cs);
}






inline bool
decompose_matrix(const LMatrix4d &mat,
                 LVecBase3d &scale,
                 LVecBase3d &shear,
                 LVecBase3d &hpr,
                 LVecBase3d &translate,
                 CoordinateSystem cs) {

  mat.get_row3(translate, 3);
  if (!decompose_matrix(mat.get_upper_3(), scale, shear, hpr, cs)) {
    return false;
  }

  return mat.get_col(3).almost_equal(LVecBase4d(0.0, 0.0, 0.0, 1.0));



}






inline bool
decompose_matrix(const LMatrix4d &mat,
                 double components[num_matrix_components],
                 CoordinateSystem cs) {
  LVector3d scale, shear, hpr, translate;
  bool result = decompose_matrix(mat, scale, shear, hpr, translate, cs);
  components[0] = scale[0];
  components[1] = scale[1];
  components[2] = scale[2];
  components[3] = shear[0];
  components[4] = shear[1];
  components[5] = shear[2];
  components[6] = hpr[0];
  components[7] = hpr[1];
  components[8] = hpr[2];
  components[9] = translate[0];
  components[10] = translate[1];
  components[11] = translate[2];
  return result;
}






inline void
compose_matrix(LMatrix3d &mat,
               const LVecBase3d &scale,
               const LVecBase3d &hpr,
               CoordinateSystem cs) {
  compose_matrix(mat, scale, LVecBase3d(0, 0, 0), hpr, cs);
}


inline void
compose_matrix(LMatrix4d &mat,
               const LVecBase3d &scale,
               const LVecBase3d &hpr,
               const LVecBase3d &translate,
               CoordinateSystem cs) {
  LMatrix3d upper3;
  compose_matrix(upper3, scale, hpr, cs);
  mat = LMatrix4d(upper3, translate);
}


inline bool
decompose_matrix(const LMatrix3d &mat,
                 LVecBase3d &scale,
                 LVecBase3d &hpr,
                 CoordinateSystem cs) {
  LVecBase3d shear;
  if (!decompose_matrix(mat, scale, shear, hpr, cs)) {
    return false;
  }
  return shear.almost_equal(LVecBase3d::zero());
}


inline bool
decompose_matrix(const LMatrix4d &mat,
                 LVecBase3d &scale,
                 LVecBase3d &hpr,
                 LVecBase3d &translate,
                 CoordinateSystem cs) {

  mat.get_row3(translate,3);
  return decompose_matrix(mat.get_upper_3(), scale, hpr, cs);
}
