bool GLGraphicsStateGuardian::
update_vertex_buffer(GLVertexBufferContext *gvbc,
                     const GeomVertexArrayDataHandle *reader, bool force) {
  { if ((__builtin_expect(!(_supports_buffers), 0))) { if (Notify::ptr()->assert_failure("_supports_buffers", 6363, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } };
  if (reader->get_modified() == UpdateSeq::initial()) {

    return true;
  }

  gvbc->set_active(true);

  if (gvbc->was_modified(reader)) {
    int num_bytes = reader->get_data_size_bytes();
    if (glgsg_cat.is_debug() && gl_debug_buffers) {
      glgsg_cat.debug()
        << "copying " << num_bytes
        << " bytes into vertex buffer " << (int)gvbc->_index << "\n";
