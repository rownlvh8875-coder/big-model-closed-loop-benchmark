  GLint num_chars = 0;

  _glgsg->_glGetProgramiv(program, 0x8B84, &length);

  if (length > 1) {
    info_log = (char *) 
# 3114 "panda/src/glstuff/glShaderContext_src.cxx" 3 4
                       __builtin_alloca (
# 3114 "panda/src/glstuff/glShaderContext_src.cxx"
                       length
# 3114 "panda/src/glstuff/glShaderContext_src.cxx" 3 4
                       )
# 3114 "panda/src/glstuff/glShaderContext_src.cxx"
                                     ;
    _glgsg->_glGetProgramInfoLog(program, length, &num_chars, info_log);

