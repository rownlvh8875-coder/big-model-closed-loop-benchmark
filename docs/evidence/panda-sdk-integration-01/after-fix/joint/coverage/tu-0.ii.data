inline float LVector3f::
angle_rad(const LVector3f &other) const {


  if (dot(other) < 0.0f) {
    float a = ((*this)+other).length() / 2.0f;
    return MathNumbers::cpi((float)0.0f) - 2.0f * casin((std::min)(a, (float)1.0));
  } else {
    float a = ((*this)-other).length() / 2.0f;
    return 2.0f * casin((std::min)(a, (float)1.0));
  }
}





inline float LVector3f::
angle_deg(const LVector3f &other) const {
  return rad_2_deg(angle_rad(other));
}
