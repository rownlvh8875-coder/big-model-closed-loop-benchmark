void GLGraphicsBuffer::
clear(Thread *current_thread) {
  if (!is_any_clear_active()) {
    return;
  }

  GLGraphicsStateGuardian *glgsg = (GLGraphicsStateGuardian *)_gsg.p();

  if (glgsg->_glClearBufferfv == nullptr) {


    GraphicsOutput::clear(current_thread);
    return;
