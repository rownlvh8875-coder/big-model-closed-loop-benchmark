bool GLGraphicsStateGuardian::
extract_texture_data(Texture *tex) {
  bool success = true;

  report_my_errors(6080, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");

  int num_views = tex->get_num_views();
