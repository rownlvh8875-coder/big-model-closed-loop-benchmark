GraphicsOutput *GLGraphicsStateGuardian::
make_shadow_buffer(LightLensNode *light, Texture *tex, GraphicsOutput *host) {


  if (!_supports_framebuffer_object) {
    return GraphicsStateGuardian::make_shadow_buffer(light, tex, host);
  }

  bool is_point = light->is_of_type(PointLight::get_class_type());


  FrameBufferProperties fbp;
  fbp.set_depth_bits(shadow_depth_bits);

  WindowProperties props = WindowProperties::size(light->get_shadow_buffer_size());
  int flags = GraphicsPipe::BF_refuse_window;
  if (is_point) {
    flags |= GraphicsPipe::BF_size_square;
  }

  if (host != nullptr) {
    host = host->get_host();
  }

  GLGraphicsBuffer *sbuffer = new GLGraphicsBuffer(get_engine(), get_pipe(), light->get_name(), fbp, props, flags, this, host);
  sbuffer->add_render_texture(tex, GraphicsOutput::RTM_bind_or_copy, GraphicsOutput::RTP_depth);
  get_engine()->add_window(sbuffer, light->get_shadow_buffer_sort());
  return sbuffer;
}
# 8569 "panda/src/glstuff/glGraphicsStateGuardian_src.cxx"
void GLGraphicsStateGuardian::
gl_flush() const {
  PStatTimer timer(_flush_pcollector);
  glFlush();
}




GLenum GLGraphicsStateGuardian::
gl_get_error() const {
  if (_check_errors) {
    PStatTimer timer(_check_error_pcollector);
    return psd::call<PSD_GET_ERROR>(glGetError);
  } else {
    return 0;
  }
}






bool GLGraphicsStateGuardian::
report_errors_loop(int line, const char *source_file, GLenum error_code,
                   int &error_count) {
  while ((gl_max_errors < 0 || error_count < gl_max_errors) &&
         (error_code != 0)) {
    glgsg_cat.error()
      << "at " << line << " of " << source_file << " : "
      << get_error_string(error_code) << "\n";

    error_code = psd::call<PSD_GET_ERROR>(glGetError);
    error_count++;
  }

  return (error_code == 0);
}




string GLGraphicsStateGuardian::
get_error_string(GLenum error_code) {



  static const char *error_strings[] = {
    "invalid enumerant",
    "invalid value",
    "invalid operation",
    "stack overflow",
    "stack underflow",
    "out of memory",
    "invalid framebuffer operation",
    "context lost",
  };

  if (error_code == 0) {
    return "no error";

  } else if (error_code == 0x8031) {
    return "table too large";

  } else if (error_code >= 0x0500 && error_code <= 0x0507) {
    return error_strings[error_code - 0x0500];
  }


  std::ostringstream strm;
  strm << "GL error " << (int)error_code;

  return strm.str();
}





string GLGraphicsStateGuardian::
show_gl_string(const string &name, GLenum id) {
  string result;

  const GLubyte *text = glGetString(id);

  if (text == nullptr) {
    glgsg_cat.warning()
      << "Unable to query " << name << "\n";

  } else {
    result = (const char *)text;
    if (glgsg_cat.is_debug()) {
      glgsg_cat.debug()
        << name << " = " << result << "\n";
    }
  }

  return result;
}




void GLGraphicsStateGuardian::
query_gl_version() {
  _gl_vendor = show_gl_string("GL_VENDOR", 0x1F00);
  _gl_renderer = show_gl_string("GL_RENDERER", 0x1F01);
  _gl_version = show_gl_string("GL_VERSION", 0x1F02);

  _gl_version_major = 0;
  _gl_version_minor = 0;




  if (_gl_version.substr(0, 10) == "1.2 NVIDIA") {
    Filename exec_name = ExecutionEnvironment::get_binary_name();
    if (cmp_nocase(exec_name.get_basename(), "pview.exe") == 0) {
      glGetIntegerv(0x821B, &_gl_version_major);
      glGetIntegerv(0x821C, &_gl_version_minor);

      if (psd::call<PSD_GET_ERROR>(glGetError) == 0x0500) {
        _gl_version_major = 1;
        _gl_version_minor = 2;
        glgsg_cat.warning()
          << "Driver possibly misreported GL_VERSION!  Unable to detect "
             "correct OpenGL version.\n";

      } else if (_gl_version_major != 1 || _gl_version_minor != 2) {
        glgsg_cat.debug()
          << "Driver misreported GL_VERSION!  Correct version detected as "
          << _gl_version_major << "." << _gl_version_minor << "\n";
      }
      return;
    }
  }



  if (gl_version.get_num_words() > 0 && gl_version[0] >= 3) {
    glGetIntegerv(0x821B, &_gl_version_major);
    glGetIntegerv(0x821C, &_gl_version_minor);

    if (_gl_version_major >= 1) {

      if (glgsg_cat.is_debug()) {
        glgsg_cat.debug()
          << "Detected OpenGL version: "
          << _gl_version_major << "." << _gl_version_minor << "\n";
      }
      return;
    }
  }



  if (_gl_version.empty()) {
    glgsg_cat.error() << "Unable to detect OpenGL version\n";

  } else {
    string input = _gl_version;


    while (!input.empty() && !isdigit(input[0])) {
      size_t space = input.find(' ');
      if (space == string::npos) {
        break;
      }
      size_t next = space + 1;
      while (next < input.length() && isspace(input[next])) {
        ++next;
      }
      input = input.substr(next);
    }


    size_t space = input.find(' ');
    if (space != string::npos) {
      input = input.substr(0, space);
    }

    vector_string components;
    tokenize(input, components, ".");
    if (components.size() >= 1) {
      string_to_int(components[0], _gl_version_major);
    }
    if (components.size() >= 2) {
      string_to_int(components[1], _gl_version_minor);
    }

    if (glgsg_cat.is_debug()) {
      glgsg_cat.debug()
        << "GL_VERSION decoded to: "
        << _gl_version_major << "." << _gl_version_minor
        << "\n";
    }
  }
}




void GLGraphicsStateGuardian::
query_glsl_version() {
  _gl_shadlang_ver_major = 0;
  _gl_shadlang_ver_minor = 0;




  if (_gl_version_major >= 2 || has_extension("GL_ARB_shading_language_100")) {
    string ver = show_gl_string("GL_SHADING_LANGUAGE_VERSION", 0x8B8C);
    _gl_shadlang_ver_major = 1;
    _gl_shadlang_ver_minor = (_gl_version_major >= 2) ? 1 : 0;
    if (ver.empty() ||
        sscanf(ver.c_str(), "%d.%d", &_gl_shadlang_ver_major,
                                     &_gl_shadlang_ver_minor) != 2) {
      glgsg_cat.warning() << "Invalid GL_SHADING_LANGUAGE_VERSION format.\n";
    }
  }
# 8802 "panda/src/glstuff/glGraphicsStateGuardian_src.cxx"
  if (glgsg_cat.is_debug()) {
    glgsg_cat.debug()
      << "Detected GLSL "



         "version: "
      << _gl_shadlang_ver_major << "." << _gl_shadlang_ver_minor << "\n";
  }

}





void GLGraphicsStateGuardian::
save_extensions(const char *extensions) {
  if (extensions != nullptr) {
    vector_string tokens;
    extract_words(extensions, tokens);

    vector_string::iterator ti;
    for (ti = tokens.begin(); ti != tokens.end(); ++ti) {
      _extensions.insert(*ti);
    }
  }
}






void GLGraphicsStateGuardian::
get_extra_extensions() {
}




void GLGraphicsStateGuardian::
report_extensions() const {
  if (glgsg_cat.is_debug()) {
    std::ostream &out = glgsg_cat.debug();
    out << "GL Extensions:\n";

    pset<string>::const_iterator ei;
    for (ei = _extensions.begin(); ei != _extensions.end(); ++ei) {
      size_t len = (*ei).size();
      out << "  " << (*ei);


      if (len <= 38) {
        if (++ei != _extensions.end()) {
          for (int i = len; i < 38; ++i) {
            out.put(' ');
          }
          out << ' ' << (*ei);
        } else {
          out.put('\n');
          break;
        }
      }
      out.put('\n');
    }
  }
}





void *GLGraphicsStateGuardian::
get_extension_func(const char *name) {
  psd_lookup psd_request(name);




  static struct {
    const char *name;
    void *fptr;
  } compiled_function_table[] = {
# 8937 "panda/src/glstuff/glGraphicsStateGuardian_src.cxx"
    { nullptr, nullptr }
  };

  int i = 0;
  while (compiled_function_table[i].name != nullptr) {
    if (strcmp(compiled_function_table[i].name, name) == 0) {
      return psd_resolved(&psd_request, compiled_function_table[i].fptr, PSD_SOURCE_COMPILED);
    }
    ++i;
  }



  return psd_resolved(&psd_request, do_get_extension_func(name), PSD_SOURCE_RUNTIME);
}







void *GLGraphicsStateGuardian::
do_get_extension_func(const char *) {
  return nullptr;
}






void GLGraphicsStateGuardian::
set_draw_buffer(int rbtype) {

  if (_current_fbo) {
    GLuint buffers[16];
    int nbuffers = 0;
    int index = 0;
    if (_current_properties->get_color_bits() > 0) {
      if (rbtype & RenderBuffer::T_left) {
        buffers[nbuffers++] = 0x8CE0 + index;
      }
      ++index;
      if (_current_properties->is_stereo()) {
        if (rbtype & RenderBuffer::T_right) {
          buffers[nbuffers++] = 0x8CE0 + index;
        }
        ++index;
      }
    }
    for (int i = 0; i < _current_properties->get_aux_rgba(); ++i) {
      if (rbtype & (RenderBuffer::T_aux_rgba_0 << i)) {
        buffers[nbuffers++] = 0x8CE0 + index;
      }
      ++index;
    }
    for (int i = 0; i < _current_properties->get_aux_hrgba(); ++i) {
      if (rbtype & (RenderBuffer::T_aux_hrgba_0 << i)) {
        buffers[nbuffers++] = 0x8CE0 + index;
      }
      ++index;
    }
    for (int i = 0; i < _current_properties->get_aux_float(); ++i) {
      if (rbtype & (RenderBuffer::T_aux_float_0 << i)) {
        buffers[nbuffers++] = 0x8CE0 + index;
      }
      ++index;
    }
    _glDrawBuffers(nbuffers, buffers);

  } else {
    switch (rbtype & RenderBuffer::T_color) {
    case RenderBuffer::T_front:
      glDrawBuffer(0x0404);
      break;

    case RenderBuffer::T_back:
      glDrawBuffer(0x0405);
      break;

    case RenderBuffer::T_right:
      glDrawBuffer(0x0407);
      break;

    case RenderBuffer::T_left:
      glDrawBuffer(0x0406);
      break;

    case RenderBuffer::T_front_right:
      { if ((__builtin_expect(!(_current_properties->is_stereo()), 0))) { if (Notify::ptr()->assert_failure("_current_properties->is_stereo()", 9027, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };
      glDrawBuffer(0x0401);
      break;

    case RenderBuffer::T_front_left:
      { if ((__builtin_expect(!(_current_properties->is_stereo()), 0))) { if (Notify::ptr()->assert_failure("_current_properties->is_stereo()", 9032, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };
      glDrawBuffer(0x0400);
      break;

    case RenderBuffer::T_back_right:
      { if ((__builtin_expect(!(_current_properties->is_stereo()), 0))) { if (Notify::ptr()->assert_failure("_current_properties->is_stereo()", 9037, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };
      glDrawBuffer(0x0403);
      break;

    case RenderBuffer::T_back_left:
      { if ((__builtin_expect(!(_current_properties->is_stereo()), 0))) { if (Notify::ptr()->assert_failure("_current_properties->is_stereo()", 9042, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };
      glDrawBuffer(0x0402);
      break;

    default:
      break;
    }
  }



  set_color_write_mask(_color_write_mask);

  report_my_errors(9055, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
}






void GLGraphicsStateGuardian::
set_read_buffer(int rbtype) {

  if (rbtype & (RenderBuffer::T_depth | RenderBuffer::T_stencil)) {

    return;
  }

  if (_current_fbo) {
    GLuint buffer = 0x8CE0;
    int index = 1;
    if (_current_properties->is_stereo()) {
      if (rbtype & RenderBuffer::T_right) {
        buffer = 0x8CE1;
      }
      ++index;
    }
    for (int i = 0; i < _current_properties->get_aux_rgba(); ++i) {
      if (rbtype & (RenderBuffer::T_aux_rgba_0 << i)) {
        buffer = 0x8CE0 + index;
      }
      ++index;
    }
    for (int i = 0; i < _current_properties->get_aux_hrgba(); ++i) {
      if (rbtype & (RenderBuffer::T_aux_hrgba_0 << i)) {
        buffer = 0x8CE0 + index;
      }
      ++index;
    }
    for (int i = 0; i < _current_properties->get_aux_float(); ++i) {
      if (rbtype & (RenderBuffer::T_aux_float_0 << i)) {
        buffer = 0x8CE0 + index;
      }
      ++index;
    }



    psd::call<PSD_READ_BUFFER>(glReadBuffer, buffer);


  } else {

    switch (rbtype & RenderBuffer::T_color) {
    case RenderBuffer::T_front:
      psd::call<PSD_READ_BUFFER>(glReadBuffer, 0x0404);
      break;

    case RenderBuffer::T_back:
      psd::call<PSD_READ_BUFFER>(glReadBuffer, 0x0405);
      break;

    case RenderBuffer::T_right:
      psd::call<PSD_READ_BUFFER>(glReadBuffer, 0x0407);
      break;

    case RenderBuffer::T_left:
      psd::call<PSD_READ_BUFFER>(glReadBuffer, 0x0406);
      break;

    case RenderBuffer::T_front_right:
      psd::call<PSD_READ_BUFFER>(glReadBuffer, 0x0401);
      break;

    case RenderBuffer::T_front_left:
      psd::call<PSD_READ_BUFFER>(glReadBuffer, 0x0400);
      break;

    case RenderBuffer::T_back_right:
      psd::call<PSD_READ_BUFFER>(glReadBuffer, 0x0403);
      break;

    case RenderBuffer::T_back_left:
      psd::call<PSD_READ_BUFFER>(glReadBuffer, 0x0402);
      break;

    default:
      break;
    }

  }

  report_my_errors(9145, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");

}




GLenum GLGraphicsStateGuardian::
get_numeric_type(Geom::NumericType numeric_type) {
  switch (numeric_type) {
  case Geom::NT_uint16:
    return 0x1403;

  case Geom::NT_uint32:

    return 0x1405;




  case Geom::NT_uint8:
  case Geom::NT_packed_dcba:
  case Geom::NT_packed_dabc:
    return 0x1401;

  case Geom::NT_float32:
    return 0x1406;

  case Geom::NT_float64:

    return 0x140A;




  case Geom::NT_stdfloat:

    break;

  case Geom::NT_int8:
    return 0x1400;

  case Geom::NT_int16:
    return 0x1402;

  case Geom::NT_int32:

    return 0x1404;




  case Geom::NT_packed_ufloat:

    return 0x8C3B;



  }

  glgsg_cat.error()
    << "Invalid NumericType value (" << (int)numeric_type << ")\n";
  return 0x1401;
}




GLenum GLGraphicsStateGuardian::
get_texture_target(Texture::TextureType texture_type) const {
  switch (texture_type) {
  case Texture::TT_1d_texture:


    return 0x0DE0;


  case Texture::TT_1d_texture_array:


    return 0x8C18;


  case Texture::TT_2d_texture:
    return 0x0DE1;

  case Texture::TT_3d_texture:

    if (_supports_3d_texture) {
      return 0x806F;
    }

    return 0;

  case Texture::TT_2d_texture_array:

    if (_supports_2d_texture_array) {
      return 0x8C1A;
    }

    return 0;

  case Texture::TT_cube_map:
    if (_supports_cube_map) {
      return 0x8513;
    } else {
      return 0;
    }

  case Texture::TT_cube_map_array:

    if (_supports_cube_map_array) {
      return 0x9009;
    }

    return 0;

  case Texture::TT_buffer_texture:

    if (_supports_buffer_texture) {
      return 0x8C2A;
    }

    return 0;
  }

  glgsg_cat.error() << "Invalid Texture::TextureType value!\n";
  return 0x0DE1;
}




GLenum GLGraphicsStateGuardian::
get_texture_wrap_mode(SamplerState::WrapMode wm) const {
  if (gl_ignore_clamp) {
    return 0x2901;
  }
  switch (wm) {
  case SamplerState::WM_clamp:
    return _edge_clamp;

  case SamplerState::WM_repeat:
    return 0x2901;

  case SamplerState::WM_mirror:
    return _mirror_repeat;

  case SamplerState::WM_mirror_once:
    return _mirror_border_clamp;

  case SamplerState::WM_border_color:
    return _border_clamp;

  case SamplerState::WM_invalid:
    break;
  }
  glgsg_cat.error() << "Invalid SamplerState::WrapMode value!\n";
  return _edge_clamp;
}




SamplerState::WrapMode GLGraphicsStateGuardian::
get_panda_wrap_mode(GLenum wm) {
  switch (wm) {

  case 0x2900:

  case 0x812F:
    return SamplerState::WM_clamp;


  case 0x812D:
    return SamplerState::WM_border_color;


  case 0x2901:
    return SamplerState::WM_repeat;

  case 0x8370:
    return SamplerState::WM_mirror;


  case 0x8742:
  case 0x8743:
    return SamplerState::WM_mirror;

  case 0x8912:
    return SamplerState::WM_mirror_once;

  }
  glgsg_cat.error() << "Unexpected GL wrap mode " << (int)wm << "\n";
  return SamplerState::WM_clamp;
}




GLenum GLGraphicsStateGuardian::
get_texture_filter_type(SamplerState::FilterType ft, bool ignore_mipmaps) {
  if (gl_ignore_filters) {
    return 0x2600;

  } else if (ignore_mipmaps) {
    switch (ft) {
    case SamplerState::FT_nearest_mipmap_nearest:
    case SamplerState::FT_nearest:
      return 0x2600;
    case SamplerState::FT_linear:
    case SamplerState::FT_linear_mipmap_nearest:
    case SamplerState::FT_nearest_mipmap_linear:
    case SamplerState::FT_linear_mipmap_linear:
      return 0x2601;
    case SamplerState::FT_shadow:
      return 0x2601;
    case SamplerState::FT_default:
    case SamplerState::FT_invalid:
      break;
    }

  } else {
    switch (ft) {
    case SamplerState::FT_nearest:
      return 0x2600;
    case SamplerState::FT_linear:
      return 0x2601;
    case SamplerState::FT_nearest_mipmap_nearest:
      return 0x2700;
    case SamplerState::FT_linear_mipmap_nearest:
      return 0x2701;
    case SamplerState::FT_nearest_mipmap_linear:
      return 0x2702;
    case SamplerState::FT_linear_mipmap_linear:
      return 0x2703;
    case SamplerState::FT_shadow:
      return 0x2601;
    case SamplerState::FT_default:
    case SamplerState::FT_invalid:
      break;
    }
  }
  glgsg_cat.error() << "Invalid SamplerState::FilterType value!\n";
  return 0x2600;
}




SamplerState::FilterType GLGraphicsStateGuardian::
get_panda_filter_type(GLenum ft) {
  switch (ft) {
  case 0x2600:
    return SamplerState::FT_nearest;
  case 0x2601:
    return SamplerState::FT_linear;
  case 0x2700:
    return SamplerState::FT_nearest_mipmap_nearest;
  case 0x2701:
    return SamplerState::FT_linear_mipmap_nearest;
  case 0x2702:
    return SamplerState::FT_nearest_mipmap_linear;
  case 0x2703:
    return SamplerState::FT_linear_mipmap_linear;
  }
  glgsg_cat.error() << "Unexpected GL filter type " << (int)ft << "\n";
  return SamplerState::FT_linear;
}




GLenum GLGraphicsStateGuardian::
get_component_type(Texture::ComponentType component_type) {
  switch (component_type) {
  case Texture::T_unsigned_byte:
    return 0x1401;
  case Texture::T_unsigned_short:
    return 0x1403;
  case Texture::T_float:
    return 0x1406;
  case Texture::T_unsigned_int_24_8:
    if (_supports_depth_stencil) {
      return 0x84FA;
    } else {
      return 0x1401;
    }
  case Texture::T_int:

    return 0x1404;

  case Texture::T_byte:
    return 0x1400;
  case Texture::T_short:
    return 0x1402;


  case Texture::T_half_float:
    return 0x140B;



  case Texture::T_unsigned_int:
    return 0x1405;


  default:
    glgsg_cat.error() << "Invalid Texture::Type value!\n";
    return 0x1401;
  }
}




