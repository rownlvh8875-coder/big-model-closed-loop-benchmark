void GLGraphicsBuffer::
attach_tex(int layer, int view, Texture *attach, GLenum attachpoint) {
  GLGraphicsStateGuardian *glgsg = (GLGraphicsStateGuardian *)_gsg.p();

  if (view >= attach->get_num_views()) {
    attach->set_num_views(view + 1);
  }


  TextureContext *tc = attach->prepare_now(view, glgsg->get_prepared_objects(), glgsg);
  { if ((__builtin_expect(!(tc != nullptr), 0))) { if (Notify::ptr()->assert_failure("tc != nullptr", 1359, "panda/src/glstuff/glGraphicsBuffer_src.cxx")) { return; } } };
  GLTextureContext *gtc = _dcast((GLTextureContext*)0, tc);

  glgsg->update_texture(gtc, true);
  gtc->set_active(true);
  _texture_contexts.push_back(gtc);



  glgsg->apply_texture(gtc);


  if (glgsg->has_fixed_function_pipeline()) {
    GLclampf priority = 1.0f;
    glPrioritizeTextures(1, &gtc->_index, &priority);
  }



  if (_rb_size_z != 1) {

    { if ((__builtin_expect(!(glgsg->_glFramebufferTexture != nullptr), 0))) { if (Notify::ptr()->assert_failure("glgsg->_glFramebufferTexture != nullptr", 1380, "panda/src/glstuff/glGraphicsBuffer_src.cxx")) { return; } } };
    glgsg->_glFramebufferTexture(0x8D40, attachpoint,
                                 gtc->_index, 0);
    return;
  }


  GLenum target = glgsg->get_texture_target(attach->get_texture_type());
  if (target == 0x8513) {
    target = 0x8515 + layer;
  }

  switch (target) {

  case 0x806F:
    glgsg->_glFramebufferTexture3D(0x8D40, attachpoint,
                                   target, gtc->_index, 0, layer);
    break;
  case 0x8C1A:
    glgsg->_glFramebufferTextureLayer(0x8D40, attachpoint,
                                      gtc->_index, 0, layer);
    break;

  default:
    glgsg->_glFramebufferTexture2D(0x8D40, attachpoint,
                                   target, gtc->_index, 0);
  }
}







void GLGraphicsBuffer::
generate_mipmaps() {
  if (gl_ignore_mipmaps && !gl_force_mipmaps) {
    return;
  }

  GLGraphicsStateGuardian *glgsg = (GLGraphicsStateGuardian *)_gsg.p();



  pvector<GLTextureContext*>::iterator it;
  for (it = _texture_contexts.begin(); it != _texture_contexts.end(); ++it) {
    GLTextureContext *gtc = *it;

    if (gtc->_generate_mipmaps) {
      glgsg->generate_mipmaps(gtc);
    }
  }

  report_my_errors(1434, "panda/src/glstuff/glGraphicsBuffer_src.cxx");
}






void GLGraphicsBuffer::
end_frame(FrameMode mode, Thread *current_thread) {
  end_frame_spam(mode);
  { if ((__builtin_expect(!(_gsg != nullptr), 0))) { if (Notify::ptr()->assert_failure("_gsg != nullptr", 1445, "panda/src/glstuff/glGraphicsBuffer_src.cxx")) { return; } } };


  if (_requested_multisamples && _fbo_multisample && mode != FM_refresh) {
    resolve_multisamples();
  }

  if (mode == FM_render) {

    copy_to_textures();
  }



  GLGraphicsStateGuardian *glgsg = (GLGraphicsStateGuardian *)_gsg.p();
  glgsg->bind_fbo(0);
  _bound_tex_page = -1;

  if (mode == FM_render) {
    generate_mipmaps();
  }

  if (_host != nullptr) {
    _host->end_frame(FM_parasite, current_thread);
  } else {
    glgsg->end_frame(current_thread);
  }

  if (mode == FM_render) {
    trigger_flip();
    clear_cube_map_selection();
  }
  report_my_errors(1477, "panda/src/glstuff/glGraphicsBuffer_src.cxx");

  glgsg->pop_group_marker();
}




void GLGraphicsBuffer::
set_size(int x, int y) {
  if (_size.get_x() != x || _size.get_y() != y) {
    _needs_rebuild = true;
  }

  set_size_and_recalc(x, y);
}







void GLGraphicsBuffer::
select_target_tex_page(int page) {
  { if ((__builtin_expect(!(page >= 0 && (size_t)page < _fbo.size()), 0))) { if (Notify::ptr()->assert_failure("page >= 0 && (size_t)page < _fbo.size()", 1502, "panda/src/glstuff/glGraphicsBuffer_src.cxx")) { return; } } };

