inline int PandaNode::
do_find_parent(PandaNode *node, const CData *cdata) const {
  ConstPointerTo< Up > up = cdata->get_up();
  Up::const_iterator ui = up->find(UpConnection(node));
  if (ui == up->end()) {
    return -1;
  }
  return ui - up->begin();
}






