inline LPlanef::
LPlanef() {
  _v(0) = 0.0f;
  _v(1) = 0.0f;
  _v(2) = 1.0f;
  _v(3) = 0.0f;
}




inline LPlanef::
LPlanef(const LVecBase4f &copy) :
  LVecBase4f(copy)
{
}






inline LPlanef::
LPlanef(const LPoint3f &a, const LPoint3f &b,
                 const LPoint3f &c) {
  LVector3f u = b - a;
  LVector3f v = c - a;
  LVector3f p = ::normalize(cross(u, v));

  _v(0) = p[0];
  _v(1) = p[1];
  _v(2) = p[2];
  _v(3) = -::dot(p, a);
}





inline LPlanef::
LPlanef(const LVector3f &normal,
                 const LPoint3f &point) {
  LVector3f p = ::normalize(normal);

  _v(0) = p[0];
  _v(1) = p[1];
  _v(2) = p[2];
  _v(3) = -::dot(p, point);
}




inline LPlanef::
LPlanef(float a, float b, float c, float d) :
  LVecBase4f(a, b, c, d)
{
}




inline LPlanef LPlanef::
operator * (const LMatrix3f &mat) const {
  LVector3f new_normal = mat.xform(get_normal());
  return LPlanef(new_normal, get_point());
}




inline LPlanef LPlanef::
operator * (const LMatrix4f &mat) const {
  LVector3f new_normal = mat.xform_vec_general(get_normal());
  LPoint3f new_point = get_point() * mat;
  return LPlanef(new_normal, new_point);
}




inline void LPlanef::
operator *= (const LMatrix4f &mat) {
  (*this) = (*this) * mat;
}




inline void LPlanef::
xform(const LMatrix4f &mat) {
  (*this) = (*this) * mat;
}




inline LPlanef LPlanef::
operator - () const {
  return LPlanef(-_v(0), -_v(1), -_v(2), -_v(3));
}




inline LVector3f LPlanef::
get_normal() const {
  return LVector3f(_v(0), _v(1), _v(2));
}
# 135 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/plane_src.I"
inline float LPlanef::
dist_to_plane(const LPoint3f &point) const {
  return (_v(0) * point[0] + _v(1) * point[1] + _v(2) * point[2] + _v(3));
}





inline bool LPlanef::
normalize() {
  float l2 = get_normal().length_squared();
  if (l2 == (float)0.0f) {
    return false;

  } else if (!((((l2) - (1.0f)) < ((get_nearly_zero_value((float)0)) * (get_nearly_zero_value((float)0))) && ((l2) - (1.0f)) > -((get_nearly_zero_value((float)0)) * (get_nearly_zero_value((float)0)))))) {
    (*this) /= csqrt(l2);
  }

  return true;
}





inline LPlanef LPlanef::
normalized() const {
  float l2 = get_normal().length_squared();
  if (l2 != (float)0.0f) {
    return (*this) / csqrt(l2);
  } else {
    return (*this);
  }
}




inline LPoint3f LPlanef::
project(const LPoint3f &point) const {
  return point - get_normal() * dist_to_plane(point);
}





inline void LPlanef::
flip() {
  _v(0) = -_v(0);
  _v(1) = -_v(1);
  _v(2) = -_v(2);
  _v(3) = -_v(3);
}
