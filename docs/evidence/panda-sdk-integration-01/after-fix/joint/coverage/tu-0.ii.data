template<class Key, class Value>
class SimpleKeyValuePair {
public:
  inline SimpleKeyValuePair(const Key &key, const Value &data) :
    _key(key),
    _data(data) {}

  Key _key;

  __attribute__((always_inline)) inline const Value &get_data() const {
    return _data;
  }
  __attribute__((always_inline)) inline Value &modify_data() {
    return _data;
  }
  __attribute__((always_inline)) inline void set_data(const Value &data) {
    _data = data;
  }
  __attribute__((always_inline)) inline void set_data(Value &&data) {
    _data = std::move(data);
  }

private:
  Value _data;
};





template<class Key>
class SimpleKeyValuePair<Key, std::nullptr_t> {
public:
  inline SimpleKeyValuePair(const Key &key, std::nullptr_t data) :
    _key(key) {}

  Key _key;

  __attribute__((always_inline)) inline constexpr static std::nullptr_t get_data() { return nullptr; }
  __attribute__((always_inline)) inline constexpr static std::nullptr_t modify_data() { return nullptr; }
  __attribute__((always_inline)) inline static void set_data(std::nullptr_t) {}
};
