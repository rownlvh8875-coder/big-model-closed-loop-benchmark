inline void InputDevice::
map_button(size_t index, ButtonHandle button) {
  LightMutexHolder holder(_lock);
  if (index >= _buttons.size()) {
    _buttons.resize(index + 1, ButtonState());
  }

  _buttons[index].handle = button;
}






