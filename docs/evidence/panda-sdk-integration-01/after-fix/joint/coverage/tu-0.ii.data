    if (cdata->_ram_images[n]._pointer_image == nullptr) {
      return cdata->_ram_images[n]._image.size();
    } else {

      return do_get_ram_mipmap_page_size(cdata, n) *
             do_get_expected_mipmap_z_size(cdata, n) *
             cdata->_num_views;
    }
  }
  return 0;
}
