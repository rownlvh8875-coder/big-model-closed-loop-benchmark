inline void Filename::
set_pattern(bool pattern) {
  if (pattern != get_pattern()) {
    if (pattern) {
      _flags |= F_pattern;
    } else {
      _flags &= ~F_pattern;
    }
    locate_hash();
  }
}





inline bool Filename::
get_pattern() const {
  return (_flags & F_pattern) != 0;
}
