class CacheStats {
public:
  CacheStats() = default;
  void init();
  void reset(double now);
  void write(std::ostream &out, const char *name) const;
  inline void maybe_report(const char *name);

  inline void inc_hits();
  inline void inc_misses();
  inline void inc_adds(bool is_new);
  inline void inc_dels();
  inline void add_total_size(int count);
  inline void add_num_states(int count);

private:

  int _cache_hits = 0;
  int _cache_misses = 0;
  int _cache_adds = 0;
  int _cache_new_adds = 0;
  int _cache_dels = 0;
  int _total_cache_size = 0;
  int _num_states = 0;
  double _last_reset = 0.0;

  bool _cache_report = false;
  double _cache_report_interval = 0.0;

};

# 1 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/cacheStats.I" 1
# 17 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/cacheStats.I"
inline void CacheStats::
maybe_report(const char *name) {

  if (__builtin_expect(!!(_cache_report), 0)) {
    double now = ClockObject::get_global_clock()->get_real_time();
    if (now - _last_reset < _cache_report_interval) {
      return;
    }
    write(Notify::out(), name);
    reset(now);
  }

}




inline void CacheStats::
inc_hits() {

  ++_cache_hits;

}




inline void CacheStats::
inc_misses() {

  ++_cache_misses;

}





inline void CacheStats::
inc_adds(bool is_new) {

  if (is_new) {
    ++_cache_new_adds;
  }
  ++_cache_adds;

}




inline void CacheStats::
inc_dels() {

  ++_cache_dels;

