# 18 "/workspace/big-model-closed-loop-benchmark/output/stage7-panda-adapter-sdk-01/build-final/sdk/include/compose_matrix_src.I"
inline void
compose_matrix(LMatrix4f &mat,
               const LVecBase3f &scale,
               const LVecBase3f &shear,
               const LVecBase3f &hpr,
               const LVecBase3f &translate,
               CoordinateSystem cs) {
  LMatrix3f upper3;
  compose_matrix(upper3, scale, shear, hpr, cs);
  mat = LMatrix4f(upper3, translate);
}





inline void
compose_matrix(LMatrix4f &mat,
               const float components[num_matrix_components],
               CoordinateSystem cs) {
  LVector3f scale(components[0],
                            components[1],
                            components[2]);
  LVector3f shear(components[3],
                            components[4],
                            components[5]);
  LVector3f hpr(components[6],
                          components[7],
                          components[8]);
  LVector3f translate(components[9],
                                components[10],
                                components[11]);
  compose_matrix(mat, scale, shear, hpr, translate, cs);
}






inline bool
decompose_matrix(const LMatrix4f &mat,
                 LVecBase3f &scale,
                 LVecBase3f &shear,
                 LVecBase3f &hpr,
                 LVecBase3f &translate,
                 CoordinateSystem cs) {

  mat.get_row3(translate, 3);
  if (!decompose_matrix(mat.get_upper_3(), scale, shear, hpr, cs)) {
    return false;
  }

  return mat.get_col(3).almost_equal(LVecBase4f(0.0, 0.0, 0.0, 1.0));



}






inline bool
decompose_matrix(const LMatrix4f &mat,
                 float components[num_matrix_components],
                 CoordinateSystem cs) {
  LVector3f scale, shear, hpr, translate;
  bool result = decompose_matrix(mat, scale, shear, hpr, translate, cs);
  components[0] = scale[0];
  components[1] = scale[1];
  components[2] = scale[2];
  components[3] = shear[0];
  components[4] = shear[1];
  components[5] = shear[2];
  components[6] = hpr[0];
  components[7] = hpr[1];
  components[8] = hpr[2];
  components[9] = translate[0];
  components[10] = translate[1];
  components[11] = translate[2];
  return result;
}






inline void
compose_matrix(LMatrix3f &mat,
               const LVecBase3f &scale,
               const LVecBase3f &hpr,
               CoordinateSystem cs) {
  compose_matrix(mat, scale, LVecBase3f(0, 0, 0), hpr, cs);
}


inline void
compose_matrix(LMatrix4f &mat,
               const LVecBase3f &scale,
               const LVecBase3f &hpr,
               const LVecBase3f &translate,
               CoordinateSystem cs) {
  LMatrix3f upper3;
  compose_matrix(upper3, scale, hpr, cs);
  mat = LMatrix4f(upper3, translate);
}


inline bool
decompose_matrix(const LMatrix3f &mat,
                 LVecBase3f &scale,
                 LVecBase3f &hpr,
                 CoordinateSystem cs) {
  LVecBase3f shear;
  if (!decompose_matrix(mat, scale, shear, hpr, cs)) {
    return false;
  }
  return shear.almost_equal(LVecBase3f::zero());
}


inline bool
decompose_matrix(const LMatrix4f &mat,
                 LVecBase3f &scale,
                 LVecBase3f &hpr,
                 LVecBase3f &translate,
                 CoordinateSystem cs) {

  mat.get_row3(translate,3);
  return decompose_matrix(mat.get_upper_3(), scale, hpr, cs);
}
