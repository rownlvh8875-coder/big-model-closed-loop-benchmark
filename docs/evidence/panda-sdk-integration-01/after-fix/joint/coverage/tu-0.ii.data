class InputDevice : public TypedReferenceCount {
public:


  enum class DeviceClass {

    unknown,



    virtual_device,


    keyboard,

    mouse,
    touch,


    gamepad,

    flight_stick,
    steering_wheel,
    dance_pad,


    hmd,


    spatial_mouse,


    digitizer,
  };

  enum class Feature {

    pointer,


    keyboard,


    tracker,


    vibration,


    battery,
  };

  enum class Axis {
    none,


    x,
    y,
    z,


    yaw,
    pitch,
    roll,


    left_x,
    left_y,
    left_trigger,
    right_x,
    right_y,
    right_trigger,


    throttle,
    rudder,


    wheel,
    accelerator,
    brake,


    pressure,
  };

  enum State {
    S_unknown,
    S_up,
    S_down
  };

  class ButtonState {
  public:
    constexpr ButtonState() = default;
    inline ButtonState(ButtonHandle handle);
    __attribute__((always_inline)) inline bool is_known() const;
    __attribute__((always_inline)) inline bool is_pressed() const;

  public:
    operator bool() { return _state != S_unknown; }

    ;
    ;

    ButtonHandle handle = ButtonHandle::none();

  public:
    State _state = S_unknown;
  };

  class AxisState {
  public:
    constexpr AxisState() = default;

  public:
    operator bool() { return known && value != 0.0; }

    Axis axis = Axis::none;
    double value = 0.0;
    bool known = false;

  public:
    double _scale = 1.0;
    double _bias = 0.0;
  };

  class BatteryData {
  public:

    short level = -1;


    short max_level = -1;
  };

protected:
  InputDevice(const std::string &name, DeviceClass dev_class);

public:
  InputDevice();
  InputDevice(const InputDevice &copy) = delete;
  InputDevice &operator = (const InputDevice &copy) = delete;
  virtual ~InputDevice();

  inline std::string get_name() const;
  inline std::string get_manufacturer() const;
  inline std::string get_serial_number() const;
  inline unsigned short get_vendor_id() const;
