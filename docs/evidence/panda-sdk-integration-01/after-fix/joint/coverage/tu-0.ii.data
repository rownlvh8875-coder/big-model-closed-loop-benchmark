template<class T>
inline void PointerToBase<T>::
reassign(PointerToBase<T> &&from) noexcept {

  if (from._void_ptr != this->_void_ptr) {
    To *old_ptr = (To *)this->_void_ptr;

    this->_void_ptr = from._void_ptr;
    from._void_ptr = nullptr;


    if (old_ptr != nullptr) {
      unref_delete(old_ptr);
    }
  }
}




template<class T>
template<class Y>
inline void PointerToBase<T>::
reassign(PointerToBase<Y> &&from) noexcept {

  if (from._void_ptr != this->_void_ptr) {
    To *old_ptr = (To *)this->_void_ptr;



    To *new_ptr = (Y *)from._void_ptr;

    this->_void_ptr = new_ptr;
    from._void_ptr = nullptr;


    if (old_ptr != nullptr) {
      unref_delete(old_ptr);
    }
  }
}





template<class T>
inline void PointerToBase<T>::
reassign(To *ptr) {
  if (ptr != (To *)_void_ptr) {




    To *old_ptr = (To *)_void_ptr;

    _void_ptr = (void *)ptr;
    if (ptr != nullptr) {
      ptr->ref();

      update_type(ptr);

    }


    if (old_ptr != nullptr) {
      unref_delete(old_ptr);
    }
  }
}




template<class T>
inline void PointerToBase<T>::
reassign(const PointerToBase<To> &copy) {
  if (copy._void_ptr != _void_ptr) {




    To *old_ptr = (To *)_void_ptr;
    To *new_ptr = (To *)copy._void_ptr;

    _void_ptr = copy._void_ptr;
    if (new_ptr != nullptr) {
      new_ptr->ref();
    }


    if (old_ptr != nullptr) {
      unref_delete(old_ptr);
    }
  }
}





template<class T>
inline void PointerToBase<T>::
update_type(To *ptr) {

  if (MemoryUsage::get_track_memory_usage()) {
    TypeHandle type = _get_type_handle((const To *)0);
    if (type == TypeHandle::none()) {
      _do_init_type((const To *)0);
      type = _get_type_handle((const To *)0);
    }
    if (type != TypeHandle::none()) {
      MemoryUsage::update_type(ptr, type);
    }
  }

}





template<class T>
__attribute__((always_inline)) inline void PointerToBase<T>::
clear() {
  reassign(nullptr);
}





template<class T>
inline void PointerToBase<T>::
output(std::ostream &out) const {
  out << _void_ptr;
  if (_void_ptr != nullptr) {
    out << ":" << ((To *)_void_ptr)->get_ref_count();
  }
}
