void GLGraphicsBuffer::
close_buffer() {
  _rb_data_size_bytes = 0;
  if (_rb_context != nullptr) {
    _rb_context->update_data_size_bytes(0);
    delete _rb_context;
    _rb_context = nullptr;
  }

  check_host_valid();

  if (_gsg == 0) {
    return;
  }


  GLGraphicsStateGuardian *glgsg;
  { (glgsg) = _dcast_ref(glgsg, _gsg); { if ((__builtin_expect(!((void *)(glgsg) != nullptr), 0))) { if (Notify::ptr()->assert_failure("(void *)(glgsg) != nullptr", 1756, "panda/src/glstuff/glGraphicsBuffer_src.cxx")) { return; } } }; };

  report_my_errors(1758, "panda/src/glstuff/glGraphicsBuffer_src.cxx");

  for (int i=0; i<RTP_COUNT; i++) {
    if (_rb[i] != 0) {
      glgsg->_glDeleteRenderbuffers(1, &(_rb[i]));
      _rb[i] = 0;
    }
  }

  for (int i=0; i<RTP_COUNT; i++) {
    if (_rbm[i] != 0) {
      glgsg->_glDeleteRenderbuffers(1, &(_rbm[i]));
      _rb[i] = 0;
    }
  }

  _rb_size_x = 0;
  _rb_size_y = 0;
  report_my_errors(1776, "panda/src/glstuff/glGraphicsBuffer_src.cxx");


  if (!_fbo.empty()) {
    glgsg->_glDeleteFramebuffers(_fbo.size(), _fbo.data());
