inline int
cpow(int x, int y) {
  int result = 1;

  if (y >= 0) {
    for(; y > 0; --y) {
      result *= x;
    }
    return result;

  } else {
    for(; y < 0; ++y) {
      result *= x;
    }
    return 1 / result;
  }
}




