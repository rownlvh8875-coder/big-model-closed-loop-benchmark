inline PStatThread::
PStatThread(Thread *thread, PStatClient *client) {

  if (client == nullptr) {
    client = PStatClient::get_global_pstats();
  }

  int thread_index = thread->get_pstats_index();
  if (thread_index != -1) {
    (*this) = PStatThread(client, thread_index);

  } else {


    (*this) = client->make_thread(thread);
  }




}




