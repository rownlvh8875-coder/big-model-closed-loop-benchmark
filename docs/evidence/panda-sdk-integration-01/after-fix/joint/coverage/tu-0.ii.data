inline float LVector3f::
signed_angle_rad(const LVector3f &other,
                 const LVector3f &ref) const {
  float angle = angle_rad(other);
  if (cross(other).dot(ref) < 0.0f) {
    angle = -angle;
  }
  return angle;
}
