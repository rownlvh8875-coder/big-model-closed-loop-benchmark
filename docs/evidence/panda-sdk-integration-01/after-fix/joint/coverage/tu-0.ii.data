  _fnear = fnear;
  _ffar = ffar;
  _l = -1.0f;
  _r = 1.0f;
  _t = 1.0f;
  _b = -1.0f;
}




inline void LFrustumd::
make_ortho(double fnear, double ffar, double l, double r,
           double t, double b) {
  _fnear = fnear;
  _ffar = ffar;
  _l = l;
  _r = r;
  _t = t;
  _b = b;
}




inline void LFrustumd::
make_perspective_hfov(double hfov, double aspect, double fnear,
                      double ffar) {
  _fnear = fnear;
  _ffar = ffar;
  _r = tan(deg_2_rad(hfov) * 0.5) * _fnear;
  _l = -_r;
  _t = _r / aspect;
  _b = -_t;
}




inline void LFrustumd::
make_perspective_vfov(double yfov, double aspect, double fnear,
                      double ffar) {
  _fnear = fnear;
  _ffar = ffar;
  _t = tan(deg_2_rad(yfov) * 0.5f) * _fnear;
  _b = -_t;
  _r = _t * aspect;
  _l = -_r;
}




inline void LFrustumd::
make_perspective(double xfov, double yfov, double fnear,
                 double ffar) {
  _fnear = fnear;
  _ffar = ffar;
  _t = tan(deg_2_rad(yfov) * 0.5f) * _fnear;
  _b = -_t;
  _r = tan(deg_2_rad(xfov) * 0.5f) * _fnear;
  _l = -_r;
}




inline void LFrustumd::
get_perspective_params(double& yfov, double& aspect,
                       double& fnear, double& ffar) const {
  yfov = rad_2_deg(atan(_t / _fnear)) * 2.0f;
  aspect = _r / _t;
  fnear = _fnear;
  ffar = _ffar;
}




inline void LFrustumd::
get_perspective_params(double& xfov, double& yfov, double& aspect,
                       double& fnear, double& ffar) const {
  xfov = rad_2_deg(atan(_r / _fnear)) * 2.0f;
  get_perspective_params(yfov, aspect, fnear, ffar);
}





inline LMatrix4d LFrustumd::
get_perspective_projection_mat(CoordinateSystem cs) const {
  if (cs == CS_default) {
    cs = get_default_coordinate_system();
  }

  double recip_r_minus_l = 1.0f/(_r - _l);
  double recip_t_minus_b = 1.0f/(_t - _b);
  double two_fnear = 2.0f*_fnear;

  double d = (_r + _l) * recip_r_minus_l;
  double a = two_fnear * recip_r_minus_l;
  double e = two_fnear * recip_t_minus_b;
  double b = (_t + _b) * recip_t_minus_b;
  double c, f;


  if (cinf(_ffar)) {
    c = 1;
    f = -2 * _fnear;
  } else if (cinf(_fnear)) {
    c = -1;
    f = 2 * _ffar;
  } else {
    double recip_far_minus_near = 1.0f / (_ffar - _fnear);
    c = (_ffar + _fnear) * recip_far_minus_near;
    f = -_ffar * two_fnear * recip_far_minus_near;
  }
