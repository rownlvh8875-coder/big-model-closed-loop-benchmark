inline void AdaptiveLruPage::
set_lru_size(size_t lru_size) {
  if (_lru != nullptr) {
    LightMutexHolder holder(_lru->_lock);
    _lru->_total_size -= _lru_size;
    _lru->_total_size += lru_size;
    _lru_size = lru_size;
  } else {
    _lru_size = lru_size;
  }
}
