inline void AtomicAdjustGccImpl::
inc(volatile AtomicAdjustGccImpl::Integer &var) {
  __atomic_fetch_add(&var, 1, 5);
}





inline bool AtomicAdjustGccImpl::
dec(volatile AtomicAdjustGccImpl::Integer &var) {
  return (__atomic_sub_fetch(&var, 1, 5) != 0);
}





inline AtomicAdjustGccImpl::Integer AtomicAdjustGccImpl::
add(volatile AtomicAdjustGccImpl::Integer &var,
    AtomicAdjustGccImpl::Integer delta) {
  return __atomic_add_fetch(&var, delta, 5);
}




inline AtomicAdjustGccImpl::Integer AtomicAdjustGccImpl::
set(volatile AtomicAdjustGccImpl::Integer &var,
    AtomicAdjustGccImpl::Integer new_value) {

  return __atomic_exchange_n(&var, new_value, 5);
}







inline AtomicAdjustGccImpl::Integer AtomicAdjustGccImpl::
get(const volatile AtomicAdjustGccImpl::Integer &var) {
  return __atomic_load_n(&var, 5);
}




inline AtomicAdjustGccImpl::Pointer AtomicAdjustGccImpl::
set_ptr(volatile AtomicAdjustGccImpl::Pointer &var,
        AtomicAdjustGccImpl::Pointer new_value) {

  return __atomic_exchange_n(&var, new_value, 5);
}







inline AtomicAdjustGccImpl::Pointer AtomicAdjustGccImpl::
get_ptr(const volatile AtomicAdjustGccImpl::Pointer &var) {
  return __atomic_load_n(&var, 5);
}
