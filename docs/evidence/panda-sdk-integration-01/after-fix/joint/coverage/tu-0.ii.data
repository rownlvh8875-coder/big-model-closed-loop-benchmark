inline void LMatrix4d::
accumulate(const LMatrix4d &other, double weight) {



  _m(0, 0) += other._m(0, 0) * weight;
  _m(0, 1) += other._m(0, 1) * weight;
  _m(0, 2) += other._m(0, 2) * weight;
