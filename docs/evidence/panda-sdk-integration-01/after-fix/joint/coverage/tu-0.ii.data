  double get_frame_budget() const;

  void set_frame_sync(bool frame_sync);
  bool get_frame_sync() const;

  void set_timeslice_priority(bool timeslice_priority);
  bool get_timeslice_priority() const;

  void stop_threads();
  void start_threads();
