bind_clip_plane(const NodePath &plane, int plane_id) {
  { if ((__builtin_expect(!(has_fixed_function_pipeline()), 0))) { if (Notify::ptr()->assert_failure("has_fixed_function_pipeline()", 11389, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };

