bool GLGraphicsStateGuardian::
draw_tristrips(const GeomPrimitivePipelineReader *reader, bool force) {



  report_my_errors(5011, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");


  if (glgsg_cat.is_spam()) {
    glgsg_cat.spam() << "draw_tristrips: " << *(reader->get_object()) << "\n";
  }
  {
    if (connect_triangle_strips && _render_mode != RenderModeAttrib::M_wireframe) {


      int num_vertices = reader->get_num_vertices();
      _vertices_tristrip_pcollector.add_level(num_vertices);
      _primitive_batches_tristrip_pcollector.add_level(1);
      if (reader->is_indexed()) {
        const unsigned char *client_pointer;
        if (!setup_primitive(client_pointer, reader, force)) {
          return false;
        }

        if (_supports_geometry_instancing && _instance_count > 0) {
          _glDrawElementsInstanced(0x0005, num_vertices,
                                   get_numeric_type(reader->get_index_type()),
                                   client_pointer, _instance_count);
        } else

        {
          _glDrawRangeElements(0x0005,
                               reader->get_min_vertex(),
                               reader->get_max_vertex(),
                               num_vertices,
                               get_numeric_type(reader->get_index_type()),
                               client_pointer);
        }
      } else {

        if (_supports_geometry_instancing && _instance_count > 0) {
          _glDrawArraysInstanced(0x0005,
                                 reader->get_first_vertex(),
                                 num_vertices, _instance_count);
        } else

        {
          glDrawArrays(0x0005,
                          reader->get_first_vertex(),
                          num_vertices);
        }
      }

    } else {


      CPTA_int ends = reader->get_ends();

      _primitive_batches_tristrip_pcollector.add_level(ends.size());
      if (reader->is_indexed()) {
        const unsigned char *client_pointer;
        if (!setup_primitive(client_pointer, reader, force)) {
          return false;
        }
        int index_stride = reader->get_index_stride();
        GeomVertexReader mins(reader->get_mins(), 0);
        GeomVertexReader maxs(reader->get_maxs(), 0);
        { if ((__builtin_expect(!(reader->get_mins()->get_num_rows() == (int)ends.size() && reader->get_maxs()->get_num_rows() == (int)ends.size()), 0))) { if (Notify::ptr()->assert_failure("reader->get_mins()->get_num_rows() == (int)ends.size() && reader->get_maxs()->get_num_rows() == (int)ends.size()", 5081, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return false; } } }
                                                                               ;

        unsigned int start = 0;
        for (size_t i = 0; i < ends.size(); i++) {
          _vertices_tristrip_pcollector.add_level(ends[i] - start);

          if (_supports_geometry_instancing && _instance_count > 0) {
            _glDrawElementsInstanced(0x0005, ends[i] - start,
                                     get_numeric_type(reader->get_index_type()),
                                     client_pointer + start * index_stride,
                                     _instance_count);
          } else

          {
            _glDrawRangeElements(0x0005,
                                 mins.get_data1i(), maxs.get_data1i(),
                                 ends[i] - start,
                                 get_numeric_type(reader->get_index_type()),
                                 client_pointer + start * index_stride);
          }
          start = ends[i] + 2;
        }
      } else {
        unsigned int start = 0;
        int first_vertex = reader->get_first_vertex();
        for (size_t i = 0; i < ends.size(); i++) {
          _vertices_tristrip_pcollector.add_level(ends[i] - start);

          if (_supports_geometry_instancing && _instance_count > 0) {
            _glDrawArraysInstanced(0x0005, first_vertex + start,
                                   ends[i] - start, _instance_count);
          } else

          {
            glDrawArrays(0x0005, first_vertex + start,
                            ends[i] - start);
          }
          start = ends[i] + 2;
        }
      }
    }
  }

