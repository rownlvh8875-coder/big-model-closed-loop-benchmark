static void
null_glActiveTexture(GLenum gl_texture_stage) {


  { if ((__builtin_expect(!(gl_texture_stage == 0x84C0), 0))) { if (Notify::ptr()->assert_failure("gl_texture_stage == GL_TEXTURE0", 137, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx")) { return; } } };
}







