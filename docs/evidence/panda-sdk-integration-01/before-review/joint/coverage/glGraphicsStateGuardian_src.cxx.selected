    if (component_type == Texture::T_unsigned_short) {
      return 0x805B;
    } else if (component_type == Texture::T_short) {
      return 0x8F9B;
    } else if (component_type == Texture::T_byte) {
      return 0x8F97;
    } else {
      return force_sized ? 0x8058 : 0x1908;
    }


  case Texture::F_rgba4:
    return 0x8056;







  case Texture::F_rgba8:
    if (Texture::is_unsigned(component_type)) {
      return 0x8058;
    } else {
      return 0x8F97;
    }

  case Texture::F_r8i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8232;
    } else {
      return 0x8231;
    }
  case Texture::F_rg8i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8238;
    } else {
      return 0x8237;
    }
  case Texture::F_rgb8i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8D7D;
    } else {
      return 0x8D8F;
    }
  case Texture::F_rgba8i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8D7C;
    } else {
      return 0x8D8E;
    }
  case Texture::F_rgba12:
    return 0x805A;


  case Texture::F_rgba16:
    if (component_type == Texture::T_float ||
        component_type == Texture::T_half_float) {
      return 0x881A;
    } else if (Texture::is_unsigned(component_type)) {
      return 0x805B;
    } else {
      return 0x8F9B;
    }






  case Texture::F_rgba32:
    return 0x8814;


  case Texture::F_rgb:
    switch (component_type) {
    case Texture::T_float: return 0x881B;
    case Texture::T_half_float: return 0x881B;

    case Texture::T_unsigned_short: return 0x8054;
    case Texture::T_short: return 0x8F9A;
    case Texture::T_byte: return 0x8F96;

    default:
      return force_sized ? 0x8051 : 0x1907;
    }

  case Texture::F_rgb5:




    return 0x8050;

  case Texture::F_rgba5:
    return 0x8057;
  case Texture::F_rgb8:
    if (Texture::is_unsigned(component_type)) {
      return 0x8051;
    } else {
      return 0x8F96;
    }
  case Texture::F_rgb12:
    return 0x8053;
  case Texture::F_rgb16:
    if (component_type == Texture::T_float ||
        component_type == Texture::T_half_float) {
      return 0x881B;
    } else if (Texture::is_unsigned(component_type)) {
      return 0x8054;
    } else {
      return 0x8F9A;
    }

  case Texture::F_rgb32:
    return 0x8815;


  case Texture::F_rgb332:
    return 0x2A10;
  case Texture::F_r16:
    if (component_type == Texture::T_float ||
        component_type == Texture::T_half_float) {
      return 0x822D;
    } else if (Texture::is_unsigned(component_type)) {
      return 0x822A;
    } else {
      return 0x8F98;
    }
  case Texture::F_rg16:
    if (component_type == Texture::T_float ||
        component_type == Texture::T_half_float) {
      return 0x822F;
    } else if (Texture::is_unsigned(component_type)) {
      return 0x822C;
    } else {
      return 0x8F99;
    }
  case Texture::F_r16i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8234;
    } else {
      return 0x8233;
    }
  case Texture::F_rg16i:
    if (Texture::is_unsigned(component_type)) {
      return 0x823A;
    } else {
      return 0x8239;
    }
  case Texture::F_rgb16i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8D77;
    } else {
      return 0x8D89;
    }
  case Texture::F_rgba16i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8D76;
    } else {
      return 0x8D88;
    }



  case Texture::F_r32:
    return 0x822E;
  case Texture::F_rg32:
    return 0x8230;

  case Texture::F_red:
  case Texture::F_green:
  case Texture::F_blue:

    if (!Texture::is_unsigned(component_type)) {
      return 0x8F94;
    } else

    {
      return force_sized ? 0x8229 : 0x1903;
    }


  case Texture::F_alpha:



    if (_supports_luminance_texture) {
      return force_sized ? 0x803C : 0x1906;
    } else {
      return force_sized ? 0x8229 : 0x1903;
    }


  case Texture::F_luminance:



    if (_supports_luminance_texture) {
      switch (component_type) {
      case Texture::T_float:
      case Texture::T_half_float:
        return 0x881E;
      case Texture::T_short:
        return 0x9019;
      case Texture::T_unsigned_short:
        return 0x8042;
      default:
        return force_sized ? 0x8040 : 0x1909;
      }
    } else {
      switch (component_type) {
      case Texture::T_float:
      case Texture::T_half_float:
        return 0x822D;
      case Texture::T_short:
        return 0x8F98;
      case Texture::T_unsigned_short:
        return 0x822A;
      default:
        return force_sized ? 0x8229 : 0x1903;
      }
    }

  case Texture::F_luminance_alpha:
  case Texture::F_luminance_alphamask:



    if (_supports_luminance_texture) {
      switch (component_type) {
      case Texture::T_float:
      case Texture::T_half_float:
        return 0x881F;
      case Texture::T_short:
        return 0x9019;
      case Texture::T_unsigned_short:
        return 0x8048;
      default:
        return force_sized ? 0x8045 : 0x190A;
      }
    } else {
      switch (component_type) {
      case Texture::T_float:
      case Texture::T_half_float:
        return 0x822F;
      case Texture::T_short:
        return 0x8F99;
      case Texture::T_unsigned_short:
        return 0x822C;
      default:
        return force_sized ? 0x822B : 0x8227;
      }
    }



  case Texture::F_rg:
    return force_sized ? 0x822B : 0x8227;



  case Texture::F_srgb:
    return _supports_texture_srgb ? 0x8C41 : 0x8051;
  case Texture::F_srgb_alpha:
    return _supports_texture_srgb ? 0x8C43 : 0x8058;


  case Texture::F_sluminance:
    return _core_profile ? 0x8C41 : 0x8C47;
  case Texture::F_sluminance_alpha:
    return _core_profile ? 0x8C43 : 0x8C45;



  case Texture::F_r32i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8236;
    } else {
      return 0x8235;
    }
  case Texture::F_rg32i:
    if (Texture::is_unsigned(component_type)) {
      return 0x823C;
    } else {
      return 0x823B;
    }
  case Texture::F_rgb32i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8D71;
    } else {
      return 0x8D83;
    }
  case Texture::F_rgba32i:
    if (Texture::is_unsigned(component_type)) {
      return 0x8D70;
    } else {
      return 0x8D82;
    }



  case Texture::F_r11_g11_b10:
    return 0x8C3A;

  case Texture::F_rgb9_e5:
    return 0x8C3D;

  case Texture::F_rgb10_a2:
    return 0x8059;


  default:
    glgsg_cat.error()
      << "Invalid image format in get_internal_image_format(): "
      << (int)format << "\n";
    return force_sized ? 0x8051 : 0x1907;
  }
}





bool GLGraphicsStateGuardian::
is_mipmap_filter(GLenum min_filter) {
  switch (min_filter) {
  case 0x2700:
  case 0x2701:
  case 0x2702:
  case 0x2703:
    return true;

  default:
    return false;
  }
}





bool GLGraphicsStateGuardian::
is_compressed_format(GLenum format) {
  switch (format) {
  case 0x83F0:
  case 0x83F1:






  case 0x83F2:
  case 0x83F3:
  case 0x86B0:
  case 0x86B1:

  case 0x8DBB:
  case 0x8DBC:
  case 0x8DBD:
  case 0x8DBE:
  case 0x8C70:
  case 0x8C71:
  case 0x8C72:
  case 0x8C73:

  case 0x84ED:
  case 0x8C48:
  case 0x84EE:
  case 0x8C49:
  case 0x84E9:
  case 0x84EA:
  case 0x84EB:

    return true;

  default:
    return false;
  }
}




GLint GLGraphicsStateGuardian::
get_texture_apply_mode_type(TextureStage::Mode am) {

  switch (am) {
  case TextureStage::M_modulate: return 0x2100;
  case TextureStage::M_decal: return 0x2101;
  case TextureStage::M_blend: return 0x0BE2;
  case TextureStage::M_replace: return 0x1E01;
  case TextureStage::M_add: return 0x0104;
  case TextureStage::M_combine: return 0x8570;
  case TextureStage::M_blend_color_scale: return 0x0BE2;
  case TextureStage::M_modulate_glow: return 0x2100;
  case TextureStage::M_modulate_gloss: return 0x2100;
  default:

    break;
  }

  glgsg_cat.error()
    << "Invalid TextureStage::Mode value" << endl;
  return 0x2100;



}





GLint GLGraphicsStateGuardian::
get_texture_combine_type(TextureStage::CombineMode cm) {

  switch (cm) {
  case TextureStage::CM_undefined:
  case TextureStage::CM_replace: return 0x1E01;
  case TextureStage::CM_modulate: return 0x2100;
  case TextureStage::CM_add: return 0x0104;
  case TextureStage::CM_add_signed: return 0x8574;
  case TextureStage::CM_interpolate: return 0x8575;
  case TextureStage::CM_subtract: return 0x84E7;
  case TextureStage::CM_dot3_rgb: return 0x86AE;
  case TextureStage::CM_dot3_rgba: return 0x86AF;
  }
  glgsg_cat.error()
    << "Invalid TextureStage::CombineMode value" << endl;

  return 0x1E01;
}





GLint GLGraphicsStateGuardian::
get_texture_src_type(TextureStage::CombineSource cs,
                     int last_stage, int last_saved_result,
                     int this_stage) const {

  switch (cs) {
  case TextureStage::CS_undefined:
  case TextureStage::CS_texture: return 0x1702;
  case TextureStage::CS_constant: return 0x8576;
  case TextureStage::CS_primary_color: return 0x8577;
  case TextureStage::CS_constant_color_scale: return 0x8576;

  case TextureStage::CS_previous:
    if (last_stage == this_stage - 1) {
      return 0x8578;
    } else if (last_stage == -1) {
      return 0x8577;
    } else if (_supports_texture_saved_result) {
      return 0x84C0 + last_stage;
    } else {
      glgsg_cat.warning()
        << "Current OpenGL driver does not support texture crossbar blending.\n";
      return 0x8577;
    }

  case TextureStage::CS_last_saved_result:
    if (last_saved_result == this_stage - 1) {
      return 0x8578;
    } else if (last_saved_result == -1) {
      return 0x8577;
    } else if (_supports_texture_saved_result) {
      return 0x84C0 + last_saved_result;
    } else {
      glgsg_cat.warning()
        << "Current OpenGL driver does not support texture crossbar blending.\n";
      return 0x8577;
    }
  }

  glgsg_cat.error()
    << "Invalid TextureStage::CombineSource value" << endl;

  return 0x1702;
}





GLint GLGraphicsStateGuardian::
get_texture_operand_type(TextureStage::CombineOperand co) {
  switch (co) {
  case TextureStage::CO_undefined:
  case TextureStage::CO_src_alpha: return 0x0302;
  case TextureStage::CO_one_minus_src_alpha: return 0x0303;
  case TextureStage::CO_src_color: return 0x0300;
  case TextureStage::CO_one_minus_src_color: return 0x0301;
  }

  glgsg_cat.error()
    << "Invalid TextureStage::CombineOperand value" << endl;
  return 0x0300;
}





GLenum GLGraphicsStateGuardian::
get_fog_mode_type(Fog::Mode m) {
  switch(m) {
  case Fog::M_linear: return 0x2601;
  case Fog::M_exponential: return 0x0800;
  case Fog::M_exponential_squared: return 0x0801;




  default:
    glgsg_cat.error() << "Invalid Fog::Mode value" << endl;
    return 0x0800;
  }
}





GLenum GLGraphicsStateGuardian::
get_blend_equation_type(ColorBlendAttrib::Mode mode) {
  switch (mode) {
  case ColorBlendAttrib::M_none:
  case ColorBlendAttrib::M_add:
    return 0x8006;

  case ColorBlendAttrib::M_subtract:
    return 0x800A;

  case ColorBlendAttrib::M_inv_subtract:
    return 0x800B;
  case ColorBlendAttrib::M_min:
    return 0x8007;

  case ColorBlendAttrib::M_max:
    return 0x8008;

  }

  glgsg_cat.error()
    << "Unknown color blend mode " << (int)mode << endl;
  return 0x8006;
}




GLenum GLGraphicsStateGuardian::
get_blend_func(ColorBlendAttrib::Operand operand) {
  switch (operand) {
  case ColorBlendAttrib::O_zero:
    return 0;

  case ColorBlendAttrib::O_one:
    return 1;

  case ColorBlendAttrib::O_incoming_color:
    return 0x0300;

  case ColorBlendAttrib::O_one_minus_incoming_color:
    return 0x0301;

  case ColorBlendAttrib::O_fbuffer_color:
    return 0x0306;

  case ColorBlendAttrib::O_one_minus_fbuffer_color:
    return 0x0307;

  case ColorBlendAttrib::O_incoming_alpha:
    return 0x0302;

  case ColorBlendAttrib::O_one_minus_incoming_alpha:
    return 0x0303;

  case ColorBlendAttrib::O_fbuffer_alpha:
    return 0x0304;

  case ColorBlendAttrib::O_one_minus_fbuffer_alpha:
    return 0x0305;
  case ColorBlendAttrib::O_constant_color:
  case ColorBlendAttrib::O_color_scale:
    return 0x8001;

  case ColorBlendAttrib::O_one_minus_constant_color:
  case ColorBlendAttrib::O_one_minus_color_scale:
    return 0x8002;

  case ColorBlendAttrib::O_constant_alpha:
  case ColorBlendAttrib::O_alpha_scale:
    return 0x8003;

  case ColorBlendAttrib::O_one_minus_constant_alpha:
  case ColorBlendAttrib::O_one_minus_alpha_scale:
    return 0x8004;

  case ColorBlendAttrib::O_incoming1_color:
    return 0x88F9;

  case ColorBlendAttrib::O_one_minus_incoming1_color:
    return 0x88FA;

  case ColorBlendAttrib::O_incoming1_alpha:
    return 0x8589;

  case ColorBlendAttrib::O_one_minus_incoming1_alpha:
    return 0x88FB;


  case ColorBlendAttrib::O_incoming_color_saturate:
    return 0x0308;
  }

  glgsg_cat.error()
    << "Unknown color blend operand " << (int)operand << endl;
  return 0;
}




GLenum GLGraphicsStateGuardian::
get_usage(Geom::UsageHint usage_hint) {
  switch (usage_hint) {
  case Geom::UH_stream:



    return 0x88E0;


  case Geom::UH_static:
  case Geom::UH_unspecified:
    return 0x88E4;

  case Geom::UH_dynamic:
    return 0x88E8;

  case Geom::UH_client:
    break;
  }

  glgsg_cat.error()
    << "Unexpected usage_hint " << (int)usage_hint << endl;
  return 0x88E4;
}





