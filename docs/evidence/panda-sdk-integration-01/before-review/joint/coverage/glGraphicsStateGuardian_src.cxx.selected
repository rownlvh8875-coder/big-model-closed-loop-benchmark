  LPlane xformed_plane = plane_node->get_plane() * transform->get_mat();







  LPlaned double_plane(lcast_to((double *)0, xformed_plane));
  glClipPlane(id, double_plane.get_data());


  report_my_errors(11408, "panda/src/glstuff/glGraphicsStateGuardian_src.cxx");
}
