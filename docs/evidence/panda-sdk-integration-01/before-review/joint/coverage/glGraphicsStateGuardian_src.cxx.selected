        }
        return 0x8226;

        break;

      case Texture::F_luminance:
        if (get_supports_compressed_texture_format(Texture::CM_dxt1) && !is_3d) {
          return 0x83F0;
        }

        if (get_supports_compressed_texture_format(Texture::CM_fxt1) && !is_3d) {
