from pathlib import Path
import hashlib,json,math,struct,sys
ROOT=Path('/dev/shm/stage7-sdk3-runtime-20261116/repo');out=ROOT/'output/stage7-sdk3-prepared-texture-01/actual';observation=json.loads((out/'independent-observation.json').read_text());assert observation['analysis_validated'];folder=out/'bundle/renderer';x=json.loads((folder/'terrain.json').read_text());analysis=observation['analysis'];rows=[]
for texture in x.get('textures',[]):
 for item in texture['windows']:
  sample=x['samples'][item['sample_index']];window=item['window'];row=dict(role=texture['role'],ray=sample['ray'],candidate_triangle_index=sample['triangle_index'],window_status=window['status'],world_point=sample['world_point'],local_point=sample['local_point'])
  if window['status']=='CAPTURED':
   width=window['component_width'];components=window['num_components'];prefix='<' if window['byte_order']=='little' else '>';raw=[bytes.fromhex(v['raw_hex']) for v in window['texels']];assert hashlib.sha256(b''.join(raw)).hexdigest()==window['sample_sha256'];row.update(uv=window['uv'],texel_xy=[v['xy'] for v in window['texels']],raw_hex=[v['raw_hex'] for v in window['texels']],component_type=window['component_type'],component_width=width,num_components=components)
   if width==4 and components==1 and window['component_type']==2:
    values=[struct.unpack(prefix+'f',v)[0] for v in raw];row['cpu_float32_values']=values
    if all(math.isfinite(v) for v in values):
     fx=window['uv'][0]*window['size_xy'][0]-.5;fy=window['uv'][1]*window['size_xy'][1]-.5;a=fx-math.floor(fx);b=fy-math.floor(fy);weights=[(1-a)*(1-b),a*(1-b),(1-a)*b,a*b];value=sum(v*w for v,w in zip(values,weights));row.update(cpu_level0_bilinear_weights=weights,cpu_level0_bilinear_value=value)
     if texture['role']=='attribute':
      ratio=x['owner']['elevation_ratio'];minimum=(1-1/ratio)/2;maximum=minimum+1/ratio;uv=sample['heightfield_uv'];bounds=all(minimum<=v<=maximum for v in uv);row.update(cpu_candidate_bounds_match=bounds,cpu_candidate_yellow_branch=bounds and .01<value<.11)
   elif width==2 and components==1:row.update(cpu_unsigned16_bits=[struct.unpack(prefix+'H',v)[0] for v in raw],cpu_signed16_bits=[struct.unpack(prefix+'h',v)[0] for v in raw])
  rows.append(row)
result=dict(run_id=observation['run_id'],source_sha=observation['source_sha'],manifest_status=x['status'],sparse_policy=x.get('sparse_policy'),sparse_sample_bytes_captured=x.get('sparse_sample_bytes_captured'),sparse_rss_peak_kib=x.get('sparse_rss_peak_kib'),sparse_rss_delta_kib=analysis.get('sparse_rss_delta_kib'),attribute_window_count=analysis.get('attribute_window_count'),attribute_collection_complete=analysis.get('attribute_collection_complete'),terrain_present=x.get('terrain_present'),terrain_complete=analysis.get('terrain_complete'),terrain_tag_shader_matched=analysis.get('terrain_tag_shader_matched'),cpu_candidate_windows_captured=analysis.get('cpu_candidate_windows_captured'),owner=x.get('owner'),node=x.get('node'),camera=x.get('camera'),states=[dict(role=v['role'],pointer=v['pointer'],shader_override=v['shader_override'],shader_attrib_pointer=v['shader_attrib_pointer'],shader_id=v['shader_id'],available_inputs=[z for z in v['known_inputs'] if z['status']!='MISSING']) for v in x.get('states',[])],shader_sources=x.get('sources'),cached_shaders=x.get('shaders'),inspection_elapsed_wall_seconds=x.get('elapsed_wall_seconds'),candidate_windows=rows,texture_metadata=[{k:v for k,v in t.items() if k!='windows'} for t in x.get('textures',[])],limits=x.get('limits'),limitations=['Candidate points are nearest prior CPU GeomNode hits projected to localxy, not terrain intersections or raster samples.','Four raw CPU texels and optional LOD0 bilinear arithmetic do not prove actual GPU sampler, mipmap, anisotropy or rendered color.','CPU state composition is hypothetical; actual cull/draw/driver uniforms remain unobserved.','Raw RAM layout is not assumed to be shader RGB; only scalar float32 or16bit patterns decoded.'],gpu_program_execution_proven=False,gpu_pixel_owner_proven=False,depth_tie_proven=False,unique_cause_proven=False,repair_proven=False,stage7_complete=False)
(out/'terrain-analysis.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(dict(run_id=result['run_id'],present=result['terrain_present'],complete=result['terrain_complete'],tag_matched=result['terrain_tag_shader_matched'],node=result['node'],camera=result['camera'],elapsed=result['inspection_elapsed_wall_seconds'],states=[dict(role=v['role'],override=v['shader_override'],shader=v['shader_id']) for v in result['states']],windows=[{k:v for k,v in row.items() if k in ('role','ray','window_status','cpu_float32_values','cpu_level0_bilinear_value','cpu_candidate_yellow_branch','cpu_unsigned16_bits')} for row in rows]),indent=2))
