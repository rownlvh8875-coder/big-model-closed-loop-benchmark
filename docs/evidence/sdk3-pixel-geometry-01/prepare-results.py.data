  allfiles.append(dict(repeat=repeat,path=str(rel),nbytes=p.stat().st_size,sha256=hashlib.file_digest(p.open('rb'),'sha256').hexdigest(),retained_in_git=keep,retained_path=str(retained.relative_to(ROOT)),artifact_id=r['artifact_id']))
 if (folder/'independent-analysis.json').exists():shutil.copyfile(folder/'independent-analysis.json',d/'independent-analysis.json')
 report=json.loads((bundle/'renderer/report.json').read_text()) if (bundle/'renderer/report.json').exists() else {};analysis=r.get('analysis',{});geom=report.get('geometry',{});center=analysis.get('hits',{}).get('center',[]);candidates=[]
 if center:
