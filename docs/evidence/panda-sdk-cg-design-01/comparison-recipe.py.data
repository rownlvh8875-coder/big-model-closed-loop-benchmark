from pathlib import Path
from hashlib import sha256
import json,tarfile,zipfile,struct
root=Path('/workspace/big-model-closed-loop-benchmark');out=root/'output/stage7-panda-sdk-cg-design-01';meta=json.loads((out/'cg-inputs.json').read_text())
inv=json.loads((root/'docs/evidence/panda-sdk-abi0-image-01/actual/acceptance/candidate/installed-files.json').read_text());rows={r['path']:r for r in inv['entries']}
def sections(b):
 assert b[:6]==b'\x7fELF\x02\x01';h=struct.unpack_from('<16sHHIQQQIHHHHHH',b);ss=[struct.unpack_from('<IIQQQQIIQQ',b,h[6]+h[11]*i) for i in range(h[12])];t=ss[h[13]];names=b[t[4]:t[4]+t[5]];r={}
 for s in ss:
  end=names.find(b'\0',s[0]);n=names[s[0]:end].decode()
  if n in ['.text','.rodata']:
   data=b[s[4]:s[4]+s[5]];assert len(data)==s[5];r[n]=dict(nbytes=len(data),sha256=sha256(data).hexdigest())
 assert '.text' in r;return r
result={}
w=root/'output/stage7-python-wheel-closure/python-lock-20261114-02/wheels/panda3d-1.10.13-cp311-cp311-manylinux2014_x86_64.whl'
with tarfile.open(out/'Cg-3.1_April2012_x86_64.tgz','r:gz') as tf,zipfile.ZipFile(w) as z:
 for name in ['libCg.so','libCgGL.so']:
  matches=[m for m in tf.getmembers() if m.name in ('usr/lib64/'+name,'./usr/lib64/'+name)];assert len(matches)==1;member=matches[0];a=tf.extractfile(member).read();b=z.read('panda3d/'+name);row=rows['/opt/venv/lib/python3.11/site-packages/panda3d/'+name];assert len(b)==row['nbytes'] and sha256(b).hexdigest()==row['sha256'];aa=sections(a);bb=sections(b)
  result[name]=dict(archive_member=member.name,archive_nbytes=len(a),archive_sha256=sha256(a).hexdigest(),installed_nbytes=len(b),installed_sha256=sha256(b).hexdigest(),whole_file_equal=a==b,archive_sections=aa,installed_sections=bb,text_equal=aa['.text']==bb['.text'],rodata_equal=aa.get('.rodata')==bb.get('.rodata'),does_not_establish_all_code_or_header_abi_identity=True,archive_library_allowed_as_build_provider=False)
(out/'cg-runtime-comparison.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
