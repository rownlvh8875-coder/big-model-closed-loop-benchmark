def stable_meshes(m):
 result=[]
 for mesh in m['meshes']:
  stages=[]
  for stage in mesh['stages']:
   row={k:v for k,v in stage.items() if k not in ('effective_sampler','texture_default_sampler')};row.update({key:{k:v for k,v in stage[key].items() if k!='text'} for key in ('effective_sampler','texture_default_sampler')});stages.append(row)
  result.append(dict(mesh_id=mesh['mesh_id'],local_to_world=mesh['local_to_world'],material=mesh['material'],stages=stages))
 return result
