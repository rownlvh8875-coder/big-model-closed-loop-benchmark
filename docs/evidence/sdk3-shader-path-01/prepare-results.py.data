for p in sorted(bundle.rglob('*')):
 if not p.is_file():continue
 relative=p.relative_to(bundle);keep=p.suffix in ('.json','.jsonl','.txt') or p.name=='stacks.log';retained=p
 if keep:
  retained=dest/'bundle'/relative;retained.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(p,retained)
 index.append(dict(path=str(relative),nbytes=p.stat().st_size,sha256=hashlib.file_digest(p.open('rb'),'sha256').hexdigest(),retained_in_git=keep,retained_path=str(retained.relative_to(ROOT)),artifact_id=x['artifact_id']))
