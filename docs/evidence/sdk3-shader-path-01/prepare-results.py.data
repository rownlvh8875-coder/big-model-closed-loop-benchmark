 if (out/name).exists():shutil.copyfile(out/name,dest/name)
v=dict(run_id=x['run_id'],workflow_id=x['workflow_id'],source_sha=x['source_sha'],activation_sha=x['head_sha'],artifact_id=x['artifact_id'],artifact_size=x['artifact_size'],artifact_digest=x['artifact_digest'],zip_path=str((out/'proof.zip').relative_to(ROOT)),all_files=index,analysis_validated=x['analysis_validated'],official_model_processes=0,onnx_inferences=0,original_matrix_gate_passed=False,repair_proven=False,stage7_complete=False);(dest/'retained-index.json').write_text(json.dumps(v,indent=2)+'\n')
