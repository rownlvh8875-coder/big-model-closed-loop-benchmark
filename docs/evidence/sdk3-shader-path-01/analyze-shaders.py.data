from pathlib import Path
import hashlib,json,sys
ROOT=Path('/dev/shm/stage7-sdk3-runtime-20261116/repo');sys.path.insert(0,str(ROOT))
from scripts import sdk3_shader_path as s
out=ROOT/'output/stage7-sdk3-shader-path-01/actual';folder=out/'bundle/renderer';receipt=json.loads((out/'independent-observation.json').read_text());assert receipt['analysis_validated'];analysis=receipt['analysis'];x=json.loads((folder/'shader.json').read_text());material=json.loads((folder/'material.json').read_text());meshes={v['mesh_id']:v for v in material['meshes']};shaders={v['shader_id']:v for v in x['shaders']};raw={v['name']:(folder/v['file']).read_bytes().decode('utf-8') for v in x['sources']};defines=s.pipeline_defines(x['pipeline']) if x['pipeline'] else None

def compare(shader_id,role):
 if shader_id is None or defines is None:return dict(available=False)
 shader=shaders[shader_id];rows={}
 for stage,name in zip(('vertex','fragment'),('simplepbr.vert','simplepbr.frag') if role=='pipeline' else ('post.vert','tonemap.frag') if role=='tonemap' else ('skybox.vert','skybox.frag')):
  source=('assets/shaders/' if role=='skybox' else 'third_party/simplepbr/shaders/')+name+'.glsl';descriptor=shader['stages'][stage]['text']
  if source not in raw or descriptor is None:rows[stage]=dict(available=False);continue
  actual=(folder/descriptor['file']).read_bytes();text=actual.decode('utf-8');expected=(raw[source] if role=='skybox' else s.variant(raw[source],defines if role=='pipeline' else {},stage)).encode();first=next((i for i,(a,b) in enumerate(zip(actual,expected)) if a!=b),min(len(actual),len(expected)) if len(actual)!=len(expected) else None)
  rows[stage]=dict(available=True,file=descriptor['file'],nbytes=len(actual),sha256=hashlib.sha256(actual).hexdigest(),expected_nbytes=len(expected),expected_sha256=hashlib.sha256(expected).hexdigest(),exact_bytes=actual==expected,first_difference_byte_index=first,actual_crlf_count=actual.count(b'\r\n'),expected_crlf_count=expected.count(b'\r\n'),normalized_lf_equal_for_analysis_only=actual.replace(b'\r\n',b'\n')==expected.replace(b'\r\n',b'\n'),generated_header=text.split('#line 1',1)[0] if '#line 1' in text else '\n'.join(text.splitlines()[:8]))
 return dict(available=True,shader_id=shader_id,pointer=shader['pointer'],language=shader['language'],cached_error_flag=shader['error_flag'],stages=rows)

bindings=[]
for row in x['meshes']:
 mesh=meshes[row['mesh_id']];role='skybox' if mesh['path'].endswith('/SkyboxMesh') else 'pipeline';bindings.append(dict(mesh_id=row['mesh_id'],path=mesh['path'],role=role,net_state_pointer=row['net_state_pointer'],shader_attrib_pointer=row['shader_attrib_pointer'],program=compare(row['shader_id'],role),known_inputs=row['known_inputs']))
tone=x.get('tonemap');result=dict(run_id=receipt['run_id'],source_sha=receipt['source_sha'],status=analysis['status'],shader_recorded=analysis['shader_recorded'],shader_complete=analysis['shader_complete'],shader_variants_matched=analysis['shader_variants_matched'],source_image_equivalence=analysis['source_image_equivalence'],target_pixel_rgb=analysis['target_pixel_rgb'],target_read_sha256=x['target_read_sha256'],material_sha256=x['material_sha256'],source_file_count=len(x['sources']),shader_object_count=len(x['shaders']),bytes_captured=x['bytes_captured'],elapsed_wall_seconds=x['elapsed_wall_seconds'],enter_elapsed_s=x['shader_enter_elapsed_s'],exit_elapsed_s=x['shader_exit_elapsed_s'],pipeline=x['pipeline'],pipeline_defines=defines,mesh_bindings=bindings,tonemap=None if tone is None else dict(**tone,program=compare(tone['shader_id'],'tonemap')),pssm_owner=x['pssm_owner'],camera=x['camera'],truncation_reasons=x['truncation_reasons'],failure=x.get('failure'),shader_sources_are_cpu_cache_only=True,actual_hdr_pixel_values_unobserved=True,normalizing_byte_comparisons_never_relaxes_admission=True,gpu_program_execution_proven=False,hardware_uniform_values_proven=False,gpu_pixel_owner_proven=False,unique_cause_proven=False,repair_proven=False,stage7_complete=False)
(out/'shader-analysis.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(dict(status=result['status'],complete=result['shader_complete'],all_variants=result['shader_variants_matched'],pipeline=result['pipeline'],defines=defines,bytes=result['bytes_captured'],seconds=result['elapsed_wall_seconds'],failure=result['failure'],bindings=[dict(path=b['path'],role=b['role'],stages={k:v.get('exact_bytes') for k,v in b['program'].get('stages',{}).items()}) for b in bindings],tonemap=None if tone is None else {k:v.get('exact_bytes') for k,v in result['tonemap']['program'].get('stages',{}).items()})))
